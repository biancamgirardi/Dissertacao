  2148  ALLSEL,ALL  
  2149  OUTRES,ESOL,LAST
  2150  OUTRES,SVAR,ALL		   
  2151  !   
  2152  ! Salvar parâmetros
  2153  PARSAV,ALL,parametros,txt   
  2154  !   
  2155  ! Definindo temperatura 
  2156  TUNIF,temperatura   
  2157  !   
