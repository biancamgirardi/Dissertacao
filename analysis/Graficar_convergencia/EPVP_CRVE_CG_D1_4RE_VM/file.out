  1924  !****_ 		3.13 Criando elementos do revestimento	_****!  
  1925  !************************************************************!  
  1926  ! Obs: esses elementos ficam sobrepostos ao do solo. Durante
  1927  ! a análise, conforme vai desligando os elementos do   
  1928  ! macicço vai-se ligando os do resvestimento, se houver.   
  1929  !   
  1930  *IF,matrev,NE,0,THEN
  1931  	CMSEL,S,Casca1,ELEM
  1932  	EGEN,2,0,ALL,ALL,1,1,,,,0,0,0  
  1933  	ESEL,ALL   
  1934  	NUMMRG,NODE, , , ,LOW  
  1935  	ESEL,MAT,2 
  1936  	CM,Revestimento1,ELEM  
  1937  *ENDIF  
  1938  !   
  1939  *IF,matrev,NE,0,THEN
  1940  	CMSEL,S,Casca2,ELEM
  1941  	EGEN,2,0,ALL,ALL,1,1,,,,0,0,0  
  1942  	ESEL,ALL   
  1943  	NUMMRG,NODE, , , ,LOW  
  1944  	ESEL,MAT,2 
  1945  	CMSEL,U,Revestimento1,ELEM 
  1946  	CM,Revestimento2,ELEM  
  1947  *ENDIF  
  1948  !   
  1949  !************************************************************!  
  1950  !****_ 		3.14 Grupos Esc-rev tunel longitudinal 	_****! 
  1951  !************************************************************!  
  1952  !   
  1953  ! Primeira escavação  
  1954  i = 1   
  1955  LOCAL,11,1,0,0,lt,0,0,180,0 
  1956  ESEL,ALL
  1957  fi=0
  1958  ff=npi*Lp   
  1959  ESEL,S,CENT,Z,fi,ff 
  1960  ESEL,R,CENT,X,0,re  
  1961  ESEL,R,CENT,Y,0,180 
  1962  CM,Lesc %i%,ELEM
  1963  CMSEL,S,Lesc %i%,ELEM   
  1964  !   
  1965  ! Proximas escavações e resvestimentos
  1966  *DO,i,2,nesc,1  
  1967  	! criando grupos com os elementos escavados do passo i 
  1968  	fi=ff  
  1969  	ff=(i-1)*Lp+npi*lp 
  1970  	ESEL,S,CENT,Z,fi,ff
  1971  	ESEL,R,CENT,X,0,re 
  1972  	ESEL,R,CENT,Y,0,180
  1973  	CM,Lesc %i%,ELEM   
  1974  	CMSEL,S,Lesc %i%,ELEM  
  1975  	!  
  1976  	*IF,matrev,NE,0,THEN   
  1977  		! criando grupos com os elementos revestidos do passo i   
  1978  		*IF,i,EQ,2,THEN   
  1979  			fi=0 
  1980  		*ELSE 
  1981  			fi=npi*lp+(i-2)*lp-(lp+d0)   
  1982  		*ENDIF
  1983  		ff = (i-1)*lp+npi*lp-(lp+d0)  
  1984  		ESEL,ALL  
  1985  		ESEL,S,CENT,Z,fi,ff   
  1986  		ESEL,R,CENT,X,ri,re   
  1987  		ESEL,R,CENT,Y,0,180   
  1988  		ESEL,R,MAT,,2 
  1989  		MPCHG,i,ALL   
  1990  		CM,Lrev %i-1%,ELEM
  1991  		CMSEL,S,Lrev %i-1%,ELEM   
  1992  	*ENDIF 
  1993  	!  
  1994  	! revestindo o ultimo trecho   
  1995  	*IF,i,EQ,nesc,THEN 
  1996  		*IF,matrev,NE,0,THEN  
  1997  			*IF,revested0,EQ,1,THEN  
  1998  				fi=l2-lp-d0 
  1999  				ff=l2   
  2000  				ESEL,S,CENT,Z,fi,ff 
  2001  				ESEL,R,CENT,X,ri,re 
  2002  				ESEL,R,CENT,Y,0,180 
  2003  				ESEL,R,MAT,,2   
  2004  				MPCHG,i,ALL 
  2005  				CM,Lrev %i%,ELEM
  2006  				CMSEL,S,Lrev %i%,ELEM   
  2007  			*ENDIF   
  2008  			*IF,revesteface,EQ,1,THEN
  2009  				fi=l2   
  2010  				ff=l2+(lp)  
  2011  				ESEL,ALL
  2012  				ESEL,S,CENT,Z,fi,ff 
  2013  				ESEL,R,CENT,X,0,re  
  2014  				ESEL,R,CENT,Y,0,180 
  2015  				CM,soloface,ELEM
  2016  				CMSEL,S,soloface,ELEM   
  2017  				!   
  2018  				fi=l2   
  2019  				ff=l2+lp
  2020  				ESEL,ALL
  2021  				ESEL,S,CENT,Z,fi,ff 
  2022  				ESEL,R,CENT,X,0,re  
  2023  				ESEL,R,CENT,Y,0,180 
  2024  				EGEN,2,0,all,all,1,1,,,,0,0,0   
  2025  				NUMMRG,node, , , ,LOW   
  2026  				ESEL,R,MAT,,2   
  2027  				MPCHG,i,ALL 
  2028  				CM,Lrevface,ELEM
  2029  				CMSEL,S,Lrevface,ELEM   
  2030  			*ENDIF   
  2031  		*ENDIF
  2032  	*ENDIF 
  2033  *ENDDO  
  2034  !   
  2035  ! criando grupo de elementos escavados  
  2036  ESEL,S,CENT,Z,0,l2  
  2037  ESEL,R,CENT,X,0,re  
  2038  ESEL,R,CENT,Y,0,180 
  2039  CM,esctotallongitudinal,ELEM
  2040  CSYS,0  
