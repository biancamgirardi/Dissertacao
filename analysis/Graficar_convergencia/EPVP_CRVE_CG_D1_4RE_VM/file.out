  2183  	/POST1 
  2184  	RSYS,0 
  2185  	ESEL,S,LIVE
  2186  	PLNSOL, U,SUM, 0,1.0   
  2187  	ESEL,ALL   
  2188  *ENDIF  
  2189  !   
  2190  ! numero máximo de analises
  2191  nanalises = 0   
  2192  nanalises=nesc+nesc1
  2193  *IF,analise2,EQ,1,THEN  
  2194  	nanalises=nanalises + np2max   
  2195  *ENDIF	 
  2196  !   
  2197  ! criando a tabela com o criterio de parada do longo prazo (np2,deltau,uatual)  
  2198  *IF,analise2,EQ,1,THEN  
  2199  	*DIM,criterio,TABLE,nanalises,3
  2200  *ENDIF  
  2201  !   
  2202  ! Selecionando o nó de controle da convergencia no tempo		 
  2203  uatual = 0  
  2204  LOCAL,11,1,0,0,lt,0,0,0,0   
  2205  CSYS,11,
  2206  ALLSEL,ALL  
  2207  NSEL,S,LOC,X,Re-0.01,Re+0.01
  2208  NSEL,R,LOC,Y,teta-0.01,teta+0.01
  2209  NSEL,R,LOC,Z,0  
  2210  NSLE,R,CORNER   
  2211  CSYS,0  
  2212  *GET,nocontrole,NODE,0,NUM,MAX  
  2213  ALLSEL,ALL  
