  2042  !********************************************************************************************!  
  2043  !****_ 		3.15 Grupos esc-rev das galerias	_****!
  2044  !********************************************************************************************!  
  2045      
  2046  !   
  2047  ! Primeira escavação da primeira galeria  
  2048  i = 1   
  2049  LOCAL,12,1,re,0,lt-l2/2,0,0,90  
  2050  fi=-re  
  2051  ff=npi1*Lp1 
  2052  ESEL,ALL
  2053  CMSEL,S,VG1,VOLUME  
  2054  ESLV,S  
  2055  ESEL,R,CENT,Z,fi,ff 
  2056  ESEL,R,CENT,X,0,re1 
  2057  ESEL,R,CENT,Y,0,180 
  2058  CM,T1esc %i%,ELEM   
  2059  CMSEL,S,T1esc %i%,ELEM  
  2060  !   
  2061  ! criando grupo da entrada da galeria 1 
  2062  *IF,matrev,NE,0,THEN
  2063  	ESEL,ALL   
  2064  	CMSEL,S,Revestimento1,ELEM 
  2065  	ESEL,R,CENT,Z,fi,ff
  2066  	ESEL,R,CENT,X,0,re1-0.01   
  2067  	ESEL,R,CENT,Y,0,180
  2068  	CM,T1escent,ELEM   
  2069  	CMSEL,S,T1escent,ELEM  
  2070  *ENDIF  
  2071  !   
  2072  ! Proximas escavações e resvestimentos da primeira galeria
  2073  *IF,escavagaleria,EQ,1,THEN 
  2074  	*DO,i,2,nesc1,1
  2075  		fi=npi1*Lp1+(i-2)*Lp1 
  2076  		ff=npi1*Lp1+(i-1)*Lp1 
  2077  		ESEL,S,CENT,Z,fi,ff   
  2078  		ESEL,R,CENT,X,0,re1-0.01  
  2079  		ESEL,R,CENT,Y,0,180   
  2080  		CM,T1esc %i%,ELEM 
  2081  		CMSEL,S,T1esc %i%,ELEM
  2082  		! 
  2083  		*IF,matrev,NE,0,THEN  
  2084  			! criando grupos com os elementos revestidos do passo i  
  2085  			*IF,i,EQ,2,THEN  
  2086  				fi=-re  
  2087  			*ELSE
  2088  				fi=(i-2)*Lp1
  2089  			*ENDIF   
  2090  			*IF,i,EQ,nesc1,THEN  
  2091  				ff=l2/2-re  
  2092  			*ELSE
  2093  				ff=npi1*Lp1+(i-2)*Lp1-d01   
  2094  			*ENDIF   
  2095  			ESEL,ALL 
  2096  			CMSEL,S,Revestimento2,ELEM   
  2097  			ESEL,R,CENT,Z,fi,ff  
  2098  			ESEL,R,CENT,X,ri1,re1-0.01   
  2099  			ESEL,R,CENT,Y,0,180  
  2100  			MPCHG,nesc-1+i,ALL   
  2101  			CM,T1rev %i-1%,ELEM  
  2102  			CMSEL,S,T1rev %i-1%,ELEM 
  2103  		*ELSE 
  2104  			! não aplica revestimento   
  2105  		*ENDIF
  2106  	*ENDDO 
  2107  *ENDIF  
  2108  CSYS,0  
  2109  !   
  2110  !************************************************************!  
  2111  !****_ 4. SOLUÇÃO 					_****! 
  2112  !************************************************************!  
  2113  /SOL
