  2220  	ANTYPE,0,NEW   
  2221  	!  
  2222  	! primeira escavação 
  2223  	i=1
  2224  	CMSEL,S,LESC %i%,ELEM  
  2225  	EKILL,ALL  
  2226  	ESEL,S,LIVE
  2227  	EPLOT  
  2228  	*DO,i,2,nesc,1 
  2229  		! desligando elementos do grupo de escavação i  
  2230  		CMSEL,S,LESC %i%,ELEM 
  2231  		EKILL,ALL 
  2232  		ESEL,S,LIVE   
  2233  		EPLOT 
  2234  		! 
  2235  		! ligando elementos do grupo de revestimento i-1  
  2236  		*IF,matrev,NE,0,THEN  
  2237  			CMSEL,S,Lrev %i-1%,ELEM  
  2238  			EALIVE,ALL   
  2239  			*IF,revested0,EQ,1,THEN  
  2240  				*IF,i,EQ,nesc,THEN  
  2241  					CMSEL,S,Lrev %i%,ELEM  
  2242  					EALIVE,ALL 
  2243  				*ENDIF  
  2244  			*ENDIF   
  2245  			*IF,revesteface,EQ,1,THEN
  2246  				*IF,i,EQ,nesc,THEN  
  2247  					CMSEL,S,Lrevface,ELEM  
  2248  					EALIVE,ALL 
  2249  					CMSEL,S,soloface,ELEM  
  2250  					EKILL,ALL  
  2251  				*ENDIF  
  2252  			*ENDIF   
  2253  		*ENDIF
  2254  		ESEL,S,LIVE   
  2255  		EPLOT 
  2256  		! 
  2257  		! grupo de escavação da galeria 1   
  2258  		*IF,escavagaleria,EQ,1,THEN   
  2259  			*IF,i,EQ,nescinig,THEN   
  2260  				! escava entrada da galeria 1   
  2261  				*IF,matrev,NE,0,THEN
  2262  					ESEL,ALL   
  2263  					CMSEL,S,T1escent,ELEM  
  2264  					EKILL,ALL  
  2265  					ESEL,S,LIVE
  2266  					EPLOT  
  2267  				*ENDIF  
  2268  				!   
  2269  				*DO,j,1,nesc1,1 
  2270  					! desligando os elementos do grupo de escavação  
  2271  					ESEL,ALL   
  2272  					CMSEL,S,T1ESC %j%,ELEM 
  2273  					EKILL,ALL  
  2274  					ESEL,S,LIVE
  2275  					EPLOT  
  2276  					!  
  2277  					! ligando os elementos do grupo de revestimento
  2278  					*IF,matrev,NE,0,THEN   
  2279  						*IF,revestegaleria,EQ,1,THEN  
  2280  							*IF,j,GE,2,THEN  
  2281  								CMSEL,S,T1REV %j-1%,ELEM
  2282  								EALIVE,ALL  
  2283  							*ENDIF   
  2284  						*ENDIF
  2285  					*ENDIF 
  2286  					!  
  2287  					! plotando apenas os elementos ativos  
  2288  					ESEL,S,LIVE
  2289  					EPLOT  
  2290  				*ENDDO  
  2291  			*ENDIF   
  2292  			!
  2293  		*ENDIF
  2294  	*ENDDO 
  2295  	ESEL,ALL   
  2296  	SAVE   
  2297  	!CNVTOL,F,,tolf,,0.01  
  2298  	!CNVTOL,U,,tolu
  2299  	SOLVE  
  2300  	FINISH 
  2301  *ELSE   
  2302  	!  
  2303  	! Necessário fazer vários passos de escavação  
  2304  	ANTYPE,0,NEW   
  2305  	!  
  2306  	! Primeiro passo de escavação
  2307  	i=1
  2308  	CMSEL,S,LESC %i%,ELEM  
  2309  	EKILL,ALL  
  2310  	ESEL,S,LIVE
  2311  	EPLOT  
  2312  	TIME,tp*npi
  2313  	DELTIM,dtp,,dtpmax 
  2314  	ESEL,ALL   
  2315  	!CNVTOL,F,,tolf,,0.01  
  2316  	!CNVTOL,U,,tolu
  2317  	SOLVE  
  2318  	SAVE   
  2319  	FINISH 
  2320  	!  
  2321  	! Mostrar solução da primeira escavação
  2322  	/POST1 
  2323  	RSYS,1 
  2324  	ESEL,S,LIVE
  2325  	PLNSOL, U,SUM, 0,1.0   
  2326  	!  
  2327  	! Próximos passos de escavação  
  2328  	/SOL   
  2329  	ANTYPE,0,RESTART   
  2330  	tad1 = 0   
  2331  	*DO,i,2,nesc,1 
  2332  		! 
  2333  		! desligando elementos do grupo de escavação i  
  2334  		ESEL,ALL  
  2335  		CMSEL,S,LESC %i%,ELEM 
  2336  		EKILL,ALL 
  2337  		ESEL,S,LIVE   
  2338  		EPLOT 
  2339  		! 
  2340  		! ligando elementos do grupo de revestimento i-1  
  2341  		*IF,matrev,NE,0,THEN  
  2342  			CMSEL,S,Lrev %i-1%,ELEM  
  2343  			EALIVE,ALL   
  2344  			*IF,revested0,EQ,1,THEN  
  2345  				*IF,i,EQ,nesc,THEN  
  2346  					CMSEL,S,Lrev %i%,ELEM  
  2347  					EALIVE,ALL 
  2348  				*ENDIF  
  2349  			*ENDIF   
  2350  			*IF,revesteface,EQ,1,THEN
  2351  				*IF,i,EQ,nesc,THEN  
  2352  					CMSEL,S,Lrevface,ELEM  
  2353  					EALIVE,ALL 
  2354  					CMSEL,S,soloface,ELEM  
  2355  					EKILL,ALL  
  2356  				*ENDIF  
  2357  			*ENDIF   
  2358  		*ENDIF
  2359  		! 
  2360  		! grupo de escavação da galeria 1   
  2361  		*IF,escavagaleria,EQ,1,THEN   
  2362  			*IF,i,EQ,nescinig,THEN   
  2363  				! escava entrada da galeria 1   
  2364  				*IF,matrev,NE,0,THEN
  2365  					ESEL,ALL   
  2366  					CMSEL,S,T1escent,ELEM  
  2367  					EKILL,ALL  
  2368  					ESEL,S,LIVE
  2369  					EPLOT  
  2370  				*ENDIF  
  2371  				!   
  2372  				*DO,j,1,nesc1,1 
  2373  					! desligando os elementos do grupo de escavação  
  2374  					ESEL,ALL   
  2375  					CMSEL,S,T1ESC %j%,ELEM 
  2376  					EKILL,ALL  
  2377  					ESEL,S,LIVE
  2378  					EPLOT  
  2379  					!  
  2380  					! ligando os elementos do grupo de revestimento
  2381  					! ligando os elementos do grupo de revestimento
  2382  					*IF,matrev,NE,0,THEN   
  2383  						*IF,revestegaleria,EQ,1,THEN  
  2384  							*IF,j,GE,2,THEN  
  2385  								CMSEL,S,T1REV %j-1%,ELEM
  2386  								EALIVE,ALL  
  2387  							*ENDIF   
  2388  						*ENDIF
  2389  					*ENDIF 
  2390  					!  
  2391  					ESEL,S,LIVE
  2392  					EPLOT  
  2393  					TIME,npi*tp+tp*(i-1)+npi1*tp1+tp1*(j-1)
  2394  					DELTIM,dtp1,,dtpmax1   
  2395  					ESEL,ALL   
  2396  					SAVE   
  2397  					!CNVTOL,F,,tolf1,,0.01 
  2398  					!CNVTOL,U,,tolu1   
  2399  					SOLVE  
  2400  				*ENDDO  
  2401  				tad1 = npi1*tp1+tp1*(nesc1-1)   
  2402  			*ENDIF   
  2403  			!
  2404  		*ENDIF
  2405  		! 
  2406  		! Pular um Loop   
  2407  		*IF,escavagaleria,EQ,1,THEN   
  2408  			*IF,i,EQ,nescinig,THEN   
  2409  				*CYCLE  
  2410  			*ENDIF   
  2411  		*ENDIF
  2412  		! 
  2413  		ESEL,S,LIVE   
  2414  		EPLOT 
  2415  		TIME,npi*tp+tp*(i-1)+tad1 
  2416  		DELTIM,dtp,,dtpmax
  2417  		ESEL,ALL  
  2418  		SAVE  
  2419  		!CNVTOL,F,,tolf,,0.01 
  2420  		!CNVTOL,U,,tolu   
  2421  		SOLVE 
  2422  		! 
  2423  		! Criterio de convergencia no tempo   
  2424  		!criterio(i,1) = tp*(i-1)+tad1
  2425  		uanterior = uatual
  2426  		*GET,uatual,NODE,nocontrole,U,SUM 
  2427  		!deltau = uatual - uanterior  
  2428  		!criterio(i,2) = deltau   
  2429  	*ENDDO 
  2430  	!  
  2431  	np2 = 0
  2432  	*IF,analise2,EQ,1,THEN 
  2433  		! Faz o cálculo após o término da construção do túnel	                    								  
  2434  		*DO,i,1,np2max
  2435  			TIME,npi*tp+tp*(nesc-1)+tad1+i*tp2		 
  2436  			DELTIM,dtp2,dtp2min,dtp2max,tp2carry			  
  2437  			SAVE 
  2438  			!CNVTOL,F,,tolf2,,0.01   
  2439  			!CNVTOL,U,,tolu2			  
  2440  			SOLVE
  2441  			!
  2442  			! Criterio de parada no longo prazo  
  2443  			np2 = np2+1  
  2444  			criterio(np2,1) = npi*tp+tp*(nesc-1)+tad1+i*tp2  
  2445  			uanterior = uatual   
  2446  			*GET,uatual,NODE,nocontrole,U,SUM
  2447  			deltau = abs(uatual - uanterior) 
  2448  			criterio(np2,2) = deltau 
  2449  			criterio(np2,3) = uatual			  
  2450  			!*IF,deltau,LT,deltaumin,*EXIT			
  2451  		*ENDDO
  2452  	*ENDIF	
  2453  	FINISH 
  2454  *ENDIF  
  2455  !   
  2456  !************************************************************!  
  2457  !****_ 5. PÓS-PROCESSAMENTO 				_****! 
  2458  !************************************************************!  
  2459  !   
  2460  !************************************************************!  
  2461  !****_ 		5.1 Configurações iniciais		_****!   
  2462  !************************************************************!  
  2463  !   
  2464  ! mudando a cor da janela   
  2465  /RGB,INDEX,100,100,100,0
  2466  /RGB,INDEX,0,0,0,15 
  2467  !   
  2468  ! qualidade do arquivo jpeg de saida
  2469  JPEG,QUAL,100,  
  2470  JPEG,ORIENT,HORIZ   
  2471  JPEG,COLOR,2
  2472  JPEG,TMOD,1 
  2473  /GFILE,800, 
  2474  /TYPE,,3
  2475  !   
  2476  ! Colocando na angulação  
  2477  /VIEW,1,,-1 
  2478  /ANG,1  
  2479  /ANG,1,30,XS,1  
  2480  /ANG,1,30,XS,1  
  2481  /ANG,1,-30,YS,1 
  2482  /DIST,1,0.729,1 
  2483  /DIST,1,0.729,1 
  2484  /REPLOT 
  2485  !   
  2486  !************************************************************!  
  2487  !****_ 		5.2 Plotando nó de controle no tempo 	_****!  
  2488  !************************************************************!  
  2489  !   
  2490  ! Escrevendo criterio de convergencia no tempo  
  2491  ! criterio(:,1) - tempo 
  2492  ! criterio(:,2) - deltau
  2493  ! criterio(:,3) - uatual
  2494  !   
  2495  *IF,analise2,EQ,1,THEN  
  2496  !   
  2497  *CREATE,ansuitmp
  2498  *MWRITE,criterio,criterio,txt   
  2499  (1000(E10.4,3X))
  2500  *END
  2501  /INPUT,ansuitmp 
  2502  !   
  2503  ! formatando grafico para plotar uatual x tempo 
  2504  /RGB,INDEX,100,100,100,0
  2505  /RGB,INDEX,0,0,0,15 
  2506  /AXLAB,X,t  
  2507  /AXLAB,Y,u(r=Re,z=Lt)   
  2508  /XRANGE,0,npi*tp+tp*(nesc-1)+tad1+np2*tp2   
  2509  *VSCFUN,criteriomax,max,criterio(1,3)   
  2510  /YRANGE,0,criteriomax*1.2   
  2511  /GROPT,DIVY,20  
  2512  /GROPT,DIVX,10  
  2513  /GROPT,DIG1,3   
  2514  /GTHK,CURVE,1   
  2515  /PLOPTS,INFO,on 
  2516  !   
  2517  ! graficando na tela do Ansys   
  2518  /ERASE  
  2519  /SHOW,JPEG,,iso 
  2520  *VLEN,np2   
  2521  *VPLOT,criterio(1,1),criterio(1,3)  
  2522  /SHOW,CLOSE	
  2523  /ERASE  
  2524  !   
  2525  *ENDIF  
  2526  !   
  2527  !************************************************************!  
  2528  !****_ 		5.3 Perfis tunel longitudinal		_****!  
  2529  !************************************************************!  
  2530  /POST1  
  2531  !   
  2532  ! selecionando os nós na interface entre revestimento e o maciço  
  2533  LOCAL,11,1,0,0,lt,0,0,0,0   
  2534  CSYS,11,
  2535  ALLSEL,ALL  
  2536  NSEL,R,LOC,X,Re-0.01,Re+0.01
  2537  NSEL,R,LOC,Y,teta-0.01,teta+0.01
  2538  NSLE,R,CORNER   
  2539  CSYS,0  
  2540  !   
  2541  ! sistemas de referencias dos resultados
  2542  RSYS,0  
  2543  !   
  2544  ! dimensionando arrays  
  2545  nanalises = 0   
  2546  *GET,nanalises,ACTIVE,0,SET,NSET	! pegando o número de análises								   
  2547  *GET,ncount,NODE,,COUNT			  ! pegando numero máximo de nós selecionados   
  2548  *GET,ntotal,NODE,,NUM,MAX		  ! pegando numero total de nós 
  2549  *DIM,convergence_teta,TABLE,ncount,2+nanalises ! dimensionando tabela de convergencias  
  2550  *DIM,pressure_teta,TABLE,ncount,2+nanalises	  ! dimensionando tabela de pressões em x  
  2551  *DIM,coordz,ARRAY,ntotal		  ! dimensionando vetor de coordenadas nodais 
  2552  *DIM,u_teta,ARRAY,ntotal			  ! dimensionando vetor de deslocamentos em x
  2553  *DIM,s_teta,ARRAY,ntotal			  ! dimensionando vetor de pressões em x
  2554  *DIM,n_sel,ARRAY,ntotal			  ! dimensionando vetor que indica se o nó está selecionado 
  2555  !   
  2556  ! coloca lista de nós em ordem na primeira coluna  
  2557  *VGET,convergence_teta(1,1),NODE,,NLIST 
  2558  *VGET,pressure_teta(1,1),NODE,,NLIST
  2559  !   
  2560  ! criando vetor de coordenadas  
  2561  *VGET,n_sel(1),NODE,1,NSEL  
  2562  *VGET,coordz(1),NODE,1,LOC,z
  2563  *VOPER,coordz(1),coordz(1),MULT,1/Re
  2564  !   
  2565  ! Preenchendo o convergence e pressure com as coordenadas   
  2566  *VMASK,n_sel(1)				! usa como mascara os nós selecionados  
  2567  *VFUN,convergence_teta(1,2),COMP,coordz(1)  
  2568  *VMASK,n_sel(1) 
  2569  *VFUN,pressure_teta(1,2),COMP,coordz(1) 
  2570  !   
  2571  ! preenchendo o convergence com a convergência 
  2572  *DO,i,1,nanalises,1 
  2573  	! identifica o passo   
  2574  	*IF,i,EQ,nanalises,THEN
  2575  		SUBSET,LAST   
  2576  	*ELSE  
  2577  		*IF,matmacico,LE,1,AND,matrev,EQ,0,THEN   
  2578  			SUBSET,LAST  
  2579  		*ELSE 
  2580  			SUBSET,i,,,,,,   
  2581  		*ENDIF
  2582  	*ENDIF 
  2583  	!  
  2584  	! Preenchendo o array com os deslocamentos radiais e tensões radiais  
  2585  	*VMASK,n_sel(1)
  2586  	*VGET,u_teta(1),NODE,1,U,direcao   
  2587  	*VOPER,u_teta(1),u_teta(1),MULT,-1/Re*100  
  2588  	!  
  2589  	*VMASK,n_sel(1)
  2590  	*VGET,s_teta(1),NODE,1,S,direcao   
  2591  	*VOPER,s_teta(1),s_teta(1),MULT,1  
  2592  	!  
  2593  	! Preenchendo o convergence e pressure 
  2594  	*VMASK,n_sel(1)
  2595  	*VFUN,convergence_teta(1,2+i),COMP,u_teta(1)   
  2596  	*VMASK,n_sel(1)
  2597  	*VFUN,pressure_teta(1,2+i),COMP,s_teta(1)  
  2598  *ENDDO  
  2599  !   
  2600  ! ordena a tabela de acordo com a segunda coluna (das coordenadas)  
  2601  *MOPER,ORDER,convergence_teta,SORT,convergence_teta(1,2)
  2602  *MOPER,ORDER,pressure_teta,SORT,pressure_teta(1,2)  
  2603  !   
  2604  ! Coleta o maior valor das convergências   
  2605  *VSCFUN,umaximofinal,max,convergence_teta(1,2+nanalises)
  2606  *VSCFUN,smaximofinal,max,pressure_teta(1,2+nanalises)   
  2607  *VSCFUN,sminimofinal,min,pressure_teta(1,2+nanalises)   
  2608  !   
  2609  ! formatando grafico de convergencia
  2610  /RGB,INDEX,100,100,100,0
  2611  /RGB,INDEX,0,0,0,15 
  2612  /AXLAB,X,Y/Re   
  2613  /AXLAB,Y,U=-u(r=Re)/Re (%)  
  2614  /XRANGE,0,Lt/Re 
  2615  /YRANGE,umaximofinal*1.2,0  
  2616  /GROPT,DIVY,20  
  2617  /GROPT,DIVX,10  
  2618  /GROPT,DIG1,3   
  2619  /GTHK,CURVE,1   
  2620  /PLOPTS,INFO,on 
  2621  !   
  2622  ! graficando na tela do Ansys   
  2623  /ERASE  
  2624  /SHOW,JPEG,,iso 
  2625  *DO,i,1,nanalises,1 
  2626  	*IF,i,EQ,nanalises,THEN
  2627  		/COLOR,CURVE,MAGE,1   
  2628  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  2629  		/COLOR,CURVE,YELL,1   
  2630  	*ELSE  
  2631  		/COLOR,CURVE,LGRA,1   
  2632  	*ENDIF 
  2633  	*VPLOT,convergence_teta(1,2),convergence_teta(1,2+i)   
  2634  	/NOERASE   
  2635  *ENDDO  
  2636  /SHOW,CLOSE 
  2637  /ERASE  
  2638  !   
  2639  !   
  2640  ! formatando grafico do pressure
  2641  /RGB,INDEX,100,100,100,0
  2642  /RGB,INDEX,0,0,0,15 
  2643  /AXLAB,X,Y/Re   
  2644  /AXLAB,Y,Sx (MPa)   
  2645  /XRANGE,0,Lt/Re 
  2646  /YRANGE,smaximofinal*1.2,sminimofinal*1.2   
  2647  /GROPT,DIVY,20  
  2648  /GROPT,DIVX,10  
  2649  /GROPT,DIG1,3   
  2650  /GTHK,CURVE,1   
  2651  /PLOPTS,INFO,on 
  2652  !   
  2653  ! graficando na tela do Ansys   
  2654  /ERASE  
  2655  /SHOW,JPEG,,iso 
  2656  *DO,i,1,nanalises,1 
  2657  	*IF,i,EQ,nanalises,THEN
  2658  		/COLOR,CURVE,MAGE,1   
  2659  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  2660  		/COLOR,CURVE,YELL,1   
  2661  	*ELSE  
  2662  		/COLOR,CURVE,LGRA,1   
  2663  	*ENDIF 
  2664  	*VPLOT,pressure_teta(1,2),pressure_teta(1,2+i) 
  2665  	/NOERASE   
  2666  *ENDDO  
  2667  /SHOW,CLOSE 
  2668  /ERASE  
  2669  !   
  2670  ! Escrevendo em arquivo as convergências   
  2671  *CREATE,ansuitmp
  2672  *MWRITE,convergence_teta,convergencias_%teta%,txt   
  2673  (1000(E10.4,3X))
  2674  *END
  2675  /INPUT,ansuitmp 
  2676  !   
  2677  ! Escrevendo em arquivo as pressões
  2678  *CREATE,ansuitmp
  2679  *MWRITE,pressure_teta,pressure_%teta%,txt   
  2680  (1000(E10.4,3X))
  2681  *END
  2682  /INPUT,ansuitmp 
  2683  !   
  2684  ! Cria arquivo com os parâmetros   
  2685  PARSAV,SCALAR,parametros,txt
  2686  !   
  2687  !************************************************************!  
  2688  !****_ 		5.4 Perfis galeria			_****!
  2689  !************************************************************!  
  2690  /POST1  
  2691  !   
  2692  !   
  2693  ! selecionando os nós na interface entre revestimento e o maciço  
  2694  LOCAL,12,1,re,0,lt-l2/2,0,0,90  
  2695  CSYS,12,
  2696  ALLSEL,ALL  
  2697  CMSEL,S,VD8,VOLU
  2698  CMSEL,A,VD61,VOLU   
  2699  NSLV,S,1
  2700  NSEL,R,LOC,X,Re1-0.01,Re1+0.01  
  2701  NSEL,R,LOC,Y,teta-0.01,teta+0.01
  2702  NSLE,R,CORNER   
  2703  CSYS,0, 
  2704  !   
  2705  ! sistemas de referencias dos resultados
  2706  RSYS,0  
  2707  !   
  2708  ! dimensionando arrays  
  2709  nanalises = 0   
  2710  *GET,nanalises,ACTIVE,0,SET,NSET	! pegando o número de análises								   
  2711  *GET,ncount,NODE,,COUNT			  ! pegando numero máximo de nós selecionados   
  2712  *GET,ntotal,NODE,,NUM,MAX		  ! pegando numero total de nós 
  2713  *DIM,convergence1_teta,TABLE,ncount,2+nanalises ! dimensionando tabela de convergencias 
  2714  *DIM,pressure1_teta,TABLE,ncount,2+nanalises	  ! dimensionando tabela de pressões em x 
  2715  *DIM,coordz1,ARRAY,ntotal		  ! dimensionando vetor de coordenadas nodais
  2716  *DIM,u1_teta,ARRAY,ntotal			  ! dimensionando vetor de deslocamentos em x   
  2717  *DIM,s1_teta,ARRAY,ntotal			  ! dimensionando vetor de pressões em x   
  2718  *DIM,n_sel,ARRAY,ntotal			  ! dimensionando vetor que indica se o nó está selecionado 
  2719  !   
  2720  ! coloca lista de nós em ordem na primeira coluna  
  2721  *VGET,convergence1_teta(1,1),NODE,,NLIST
  2722  *VGET,pressure1_teta(1,1),NODE,,NLIST   
  2723  !   
  2724  ! criando vetor de coordenadas  
  2725  *VGET,n_sel(1),NODE,1,NSEL  
  2726  *VGET,coordz1(1),NODE,1,LOC,x   
  2727  *VOPER,coordz1(1),coordz1(1),MULT,1/Re1 
  2728  !   
  2729  ! Preenchendo o convergence e pressure com as coordenadas   
  2730  *VMASK,n_sel(1)				! usa como mascara os nós selecionados  
  2731  *VFUN,convergence1_teta(1,2),COMP,coordz1(1)
  2732  *VMASK,n_sel(1) 
  2733  *VFUN,pressure1_teta(1,2),COMP,coordz1(1)   
  2734  !   
  2735  ! preenchendo o convergence com a convergência 
  2736  *DO,i,1,nanalises,1 
  2737  	! identifica o passo   
  2738  	*IF,i,EQ,nanalises,THEN
  2739  		SUBSET,LAST   
  2740  	*ELSE  
  2741  		*IF,matmacico,LE,1,AND,matrev,EQ,0,THEN   
  2742  			SUBSET,LAST  
  2743  		*ELSE 
  2744  			SUBSET,i,,,,,,   
  2745  		*ENDIF
  2746  	*ENDIF 
  2747  	!  
  2748  	! Preenchendo o array com os deslocamentos radiais e tensões radiais  
  2749  	*VMASK,n_sel(1)
  2750  	*VGET,u1_teta(1),NODE,1,U,direcao  
  2751  	*VOPER,u1_teta(1),u1_teta(1),MULT,-1/Re1*100   
  2752  	!  
  2753  	*VMASK,n_sel(1)
  2754  	*VGET,s1_teta(1),NODE,1,S,direcao  
  2755  	*VOPER,s1_teta(1),s1_teta(1),MULT,1
  2756  	!  
  2757  	! Preenchendo o convergence e pressure 
  2758  	*VMASK,n_sel(1)
  2759  	*VFUN,convergence1_teta(1,2+i),COMP,u1_teta(1) 
  2760  	*VMASK,n_sel(1)
  2761  	*VFUN,pressure1_teta(1,2+i),COMP,s1_teta(1)
  2762  *ENDDO  
  2763  !   
  2764  ! ordena a tabela de acordo com a segunda coluna (das coordenadas)  
  2765  *MOPER,ORDER,convergence1_teta,SORT,convergence1_teta(1,2)  
  2766  *MOPER,ORDER,pressure1_teta,SORT,pressure1_teta(1,2)
  2767  !   
  2768  ! Coleta o maior valor das convergências   
  2769  *VSCFUN,umaximofinal1,max,convergence1_teta(1,2+nanalises)  
  2770  *VSCFUN,smaximofinal1,max,pressure1_teta(1,2+nanalises) 
  2771  *VSCFUN,sminimofinal1,min,pressure1_teta(1,2+nanalises) 
  2772  !   
  2773  ! formatando grafico de convergencia
  2774  /RGB,INDEX,100,100,100,0
  2775  /RGB,INDEX,0,0,0,15 
  2776  /AXLAB,X,x/Re1  
  2777  /AXLAB,Y,U1=-u1(r=Re1)/Re1 (%)  
  2778  /XRANGE,0,(d1/2)/Re1
  2779  /YRANGE,umaximofinal1*1.2,0 
  2780  /GROPT,DIVY,20  
  2781  /GROPT,DIVX,10  
  2782  /GROPT,DIG1,3   
  2783  /GTHK,CURVE,1   
  2784  /PLOPTS,INFO,on 
  2785  !   
  2786  ! graficando na tela do Ansys   
  2787  /ERASE  
  2788  /SHOW,JPEG,,iso 
  2789  *DO,i,1,nanalises,1 
  2790  	*IF,i,EQ,nanalises,THEN
  2791  		/COLOR,CURVE,MAGE,1   
  2792  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  2793  		/COLOR,CURVE,YELL,1   
  2794  	*ELSE  
  2795  		/COLOR,CURVE,LGRA,1   
  2796  	*ENDIF 
  2797  	*VPLOT,convergence1_teta(1,2),convergence1_teta(1,2+i) 
  2798  	/NOERASE   
  2799  *ENDDO  
  2800  /SHOW,CLOSE 
  2801  /ERASE  
  2802  !   
  2803  !   
  2804  ! formatando grafico do pressure
  2805  /RGB,INDEX,100,100,100,0
  2806  /RGB,INDEX,0,0,0,15 
  2807  /AXLAB,X,x/Re1  
  2808  /AXLAB,Y,Sx1 (MPa)  
  2809  /XRANGE,0,(d1/2)/Re1
  2810  /YRANGE,smaximofinal1*1.2,sminimofinal1*1.2 
  2811  /GROPT,DIVY,20  
  2812  /GROPT,DIVX,10  
  2813  /GROPT,DIG1,3   
  2814  /GTHK,CURVE,1   
  2815  /PLOPTS,INFO,on 
  2816  !   
  2817  ! graficando na tela do Ansys   
  2818  /ERASE  
  2819  /SHOW,JPEG,,iso 
  2820  *DO,i,1,nanalises,1 
  2821  	*IF,i,EQ,nanalises,THEN
  2822  		/COLOR,CURVE,MAGE,1   
  2823  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  2824  		/COLOR,CURVE,YELL,1   
  2825  	*ELSE  
  2826  		/COLOR,CURVE,LGRA,1   
  2827  	*ENDIF 
  2828  	*VPLOT,pressure1_teta(1,2),pressure1_teta(1,2+i)   
  2829  	/NOERASE   
  2830  *ENDDO  
  2831  /SHOW,CLOSE 
  2832  /ERASE  
  2833  !   
  2834  ! Escrevendo em arquivo as convergências   
  2835  *CREATE,ansuitmp
  2836  *MWRITE,convergence1_teta,convergencias1_%teta%,txt 
  2837  (1000(E10.4,3X))
  2838  *END
  2839  /INPUT,ansuitmp 
  2840  !   
  2841  ! Escrevendo em arquivo as pressões
  2842  *CREATE,ansuitmp
  2843  *MWRITE,pressure1_teta,pressure1_%teta%,txt 
  2844  (1000(E10.4,3X))
  2845  *END
  2846  /INPUT,ansuitmp 
  2847  !   
  2848  ! Cria arquivo com os parâmetros   
  2849  PARSAV,SCALAR,parametros,txt
  2850  !   
  2851  !   
