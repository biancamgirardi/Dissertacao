     1  !************************************************************!  
     2  !** PROGRAMA ANÁLISE TUNEL DUPLO (MODELO 3D) 		   **!  
     3  !** Versão: 2024.01 					   **!
     4  !** 							   **!   
     5  !** Objetivo: faz análise da convergência de túneis 	   **!  
     6  !** profundos com seção circular dupla (gêmeos)		   **!  
     7  !** com/sem galerias transversais			   **!  
     8  !** considerando um modelo 3D 				   **!
     9  !** 							   **!   
    10  !** Programador: Felipe Quevedo, Carlos e Bianca Girardi   **!  
    11  !** Situação : OK (11/07/2020) 				   **! 
    12  !** Unidades : [F/A, L, t] = MPa, m, dias		   **!   
    13  !** 							   **!   
    14  !************************************************************!  
    15  !   
    16  !************************************************************!  
    17  !****_ 1. INICIALIZANDO O ANSYS 		        _****!
    18  !************************************************************!  
    19  FINISH  
    20  /CLEAR,NOSTART  
    21  !   
    22  !************************************************************!  
    23  !****_ 2. DADOS DE ENTRADA DO PROBLEMA 			_****!
    24  !************************************************************!  
    25  !   
    26  ! Nessa seção define-se todos os dados de entrada necessarios 
    27  !   
    28  !************************************************************!  
    29  !****_ 		2.1 Parâmetros geométricos		_****!   
    30  !************************************************************!  
    31  ! referente aos tuneis longitudinais
    32  Re 		= 1 		! [m] raio da interface entre o túnel e o maciço   
    33  esp		= 0.1		! [m] espessura do revestimento 
    34  Lp 		= 1/3*Re 	! [m] comprimento do passo de escavação
    35  nd0 		= 2 		! [Lp] número de passos que representam a dimensão não suportada 
    36  npi 		= 3 		! [Lp] número de passos escavados na primeira escavação  
    37  Vp 		= 12.5 		! [m/dia] velocidade do passo de escavação  
    38  revested0 	= 1 		! 0 - não reveste ultimo d0+Lp, 1 - reveste ultimo d0+Lp  
    39  revesteface 	= 1 		! 0 - não reveste a face, 1 - reveste a face
    40  !   
    41  ! referente as galeiras transversais
    42  Re1 		= 2*Lp 		! [m] raio externo da galeria (deve multiplo de Lp)  
    43  esp1		= 0.1		! [m] espessura do revestimento
    44  !Lp1 		= 1/3*Re1 	! [m] passo de escavação das galerias transversais (tem que ser multiplo de (d1/2+re))  
    45  nd01 		= 2 		! [Lp1] dimensão não suportada (deve ser multiplo de Lp1)
    46  npi1 		= 3 		! [un] numero de passos escavados na primeira escavação  
    47  Vp1 		= 12.5 		! [m/dia] velocidade de escavação  
    48  escavagaleria 	= 1 		! escavação das galerias: 0 - não escava, 1 - escava
    49  revestegaleria 	= 1 		! revestimento da galeria: 0 - não reveste, 1 - reveste  
    50  pig1 		= 15 		! [un] numero de passos de escavação a partir da galeria no qual iniciará a escavação da galeria 
    51  !   
    52  ! referente ao restante do domínio 
    53  l1 		= 10 		! [Re] comprimento do trecho não escavado (deve ser suficiente para captar os efeitos na última frente de escavação)
    54  l2 		= 100 		! [Lp] comprimento do trecho escavado  
    55  d3 		= 20 		! [Re] altura do domínio (profundidade do eixo do túnel longitudinal) 
    56  d4 		= 20 		! [Re] distância das bordas laterais do domínio até o eixo do tunel longitudinal 
    57  d1 		= 4		! [Re] distância entre eixos dos túneis longitudinais   
    58  !   
    59  ! distância adjacente a galeria com malha livre [Lp]   
    60  !   
    61  ! Lp1 deve ter uma medida que se tenha n passos inteiros para se escavar,   
    62  ! portanto: Lp1 = K*Re1 em que K = (d1/2-Re)/(n*Re1).   
    63  ! o valor de d5 é ajustado de modo a ter uma discretização na região da galeria 
    64  !   
    65  !   
    66  *IF,d1,EQ,16,THEN   
    67  	d5		= 6			 
    68  	Lp1		= 0.3387*re1  
    69  *ELSEIF,d1,EQ,4,THEN
    70  	d5		= 2
    71  	Lp1		= 0.3*re1 
    72  *ELSEIF,d1,EQ,3,THEN
    73  	d5		= 2
    74  	Lp1		= 0.25*re1
    75  *ELSEIF,d1,EQ,5,THEN
    76  	d5		= 2
    77  	Lp1		= 0.375*re1   
    78  *ELSEIF,d1,EQ,8,THEN
    79  	d5		= 4
    80  	Lp1		= 0.3214*re1	 
    81  *ENDIF  
    82  !   
    83  !   
    84  !************************************************************!  
    85  !****_  	2.2 Parâmetros constitutivos do maciço 	_****!   
    86  !************************************************************! 		   
    87  ! Tipo de material do maciço (matmacico)   
    88  !   
    89  ! 	1  - elastico do ANSYS   
    90  ! 	2  - elastoplastico VM do ANSYS (BISO)   
    91  ! 	22 - elastoplastico VM do ANSYS (MISO)   
    92  !	23 - viscoplastico Perzyna VM do ANSYS
    93  !	4  - usermat3D_VM do ANSYS (BISO) 
    94  !	5  - usermat3D_elastico   
    95  !	6  - usermat3D_EP 
    96  !	7  - usermat3D_VP 
    97  !	8  - usermat3D_EPVP	  
    98  !   
    99  matmacico	= 8   
   100  !   
   101  ! Parâmetros de todos os modelos   
   102  E1 		= 1500		 ! [MPa] modulo elasticidade (1,2,22,23,4,5,6,7,8) 
   103  nu1 		= 0.498		 ! [adm] coeficiente de poisson (1,2,22,23,4,5,6,7,8)
   104  !   
   105  ! Parametros para o modelo 2, 22, 6 e 8 
   106  superficief	= 2		 ! função de escoamento: 1-DPI, 2-DPII, 3-DPIII, 4-MC (6,8)  
   107  superficieg 	= 2		 ! função potencial: 1-DPI, 2-DPII, 3-DPIII, 4-MC (6,8) 
   108  fi	    	= 0		 ! [graus] angulo de atrito (0 - VM ou TR) (6,8)   
   109  psi	    	= fi		 ! [graus] angulo de dilatância (6,8)   
   110  c1	    	= 4*SQRT(3)/2	 ! [MPa] coesão inicial (2,22,23,4,6,8)  
   111  c2	    	= 4*SQRT(3)/2  	 ! [MPa] coesão de pico (2,22,23,4,6,8)
   112  c3	    	= 4*SQRT(3)/2 	 ! [MPa] coesão residual (22,6,8)   
   113  eps1	    	= 0.010		 ! [adm] deformação equiv. limite da zona 1 (22,6,8)   
   114  eps2	    	= 0.010		 ! [adm] deformação equiv. limite da zona 2 (22,6,8)   
   115  eps3	    	= 0.010		 ! [adm] deformação equiv. limite da zona 3 (22,6,8)   
   116  Dalg		= 0		 ! 0 - módulo elastico, 1 - módulo algoritmíco (6,8)  
   117  !   
   118  ! Parametros para o modelo 23, 7 e 8
   119  superficiefvp 	= 2		 ! função de escoamento: 1-DPI, 2-DPII, 3-DPIII, 4-MC (7,8)   
   120  superficiegvp 	= 2		 ! função potencial: 1-DPI, 2-DPII, 3-DPIII, 4-MC (7,8)   
   121  fivp          	= 0		 ! [graus] angulo de atrito (0 - VM ou TR)(7,8) 
   122  psivp         	= fivp		 ! [graus] angulo de dilatância (7,8)   
   123  cvp 	      	= 2*SQRT(3)/2	 ! [MPa] coesão viscoplastica (23,7,8)   
   124  n1	      	= 1		 ! [adm] expoente do modelo de Perzyna (23,7,8)  
   125  eta           	= 4E4 		 ! [dia] constante de viscosidade dinâmica (23,7,8) 
   126  f0     	      	= 1		 ! [MPa] valor de referência (23,7,8)  
   127  thetavp       	= 1		 ! 0 - totalmente explícito, 1 - semi-implicito (7,8)  
   128  !   
   129  !********************************************************************!  
   130  !****_ 		2.3 Parâmetros constitutivos do revest	_****! 
   131  !********************************************************************!  
   132  ! Tipo de material  
   133  !	0 - Sem revestimento  
   134  !	1 - Ansys_Elástico   
   135  !	2 - Usermat_Viscoelastico_CEB-MC90
   136  !   
   137  matrev 		= 2		! Tipo de material (0-SR,1-E,2-VE)
   138  !   
   139  ! Parâmetros para os modelos 1 e 2 
   140  E2 		= 30303		! [MPa] módulo de elasticidade do revestimento (matrev=1)
   141  nu2 		= 0.2    	! [adm] coeficiente de Poisson do revestimento (matrev=1,2)		   
   142  !   
   143  ! Parâmetros para o modelo 2   
   144  fck 		= 20		! [MPa] resistência característica do concreto (2)
   145  s 		= 0.2		! [adm] coef. que depende do tipo de concreto (2)
   146  ti 		= 0		! [dias] início do concreto (2)  
   147  rh 		= 70		! [%] umidade relativa do ambiente (2)   
   148  hf 		= (Re**2-(Re-esp)**2)/(Re-esp) ! [m] espessura fictítica (QUEVEDO, 2017, p. 84) (2)   
   149  hf1		= (Re1**2-(Re1-esp1)**2)/(Re1-esp1)  ! [m] espessura fictítica da galeria (QUEVEDO, 2017, p. 84) (2)  
   150  ts 		= 7		! [dias] idade do concreto no início da secagem (2)  
   151  t0		= 1		! [dias] idade do concreto no início do carregamento (2)  
   152  tinf		= 3000		! [dias] tempo final da análise (2)  
   153  betasc 		= 8d0		! [adm] coeficiente que depende do tipo de cimento (2)  
   154  temperatura 	= 20		! [oC] temperatura (2)   
   155  alpha 		= 1		! [adm] efeito do tipo de cimento durante a cura (2)   
   156  ndec  		= 10		! [década] No. de pontos por decada na discretização (2)   
   157  ligafluencia 	= 1		! [un] 1 - liga fluência, 0 - desliga fluência (2) 
   158  ligaretracao 	= 1		! [un] 1 - liga retração, 0 - desliga retração (2)   
   159  ktime		= 10		! [dias] tempo da análise para saída de dados
   160  kelemid		= 2060		! [un] identificação do elemento para saída 
   161  kkDomIntPt	= 1		! [un] identificação do ponto de integração para saída 
   162  !   
   163  ! Calculo do módulo
   164  fcm 		= fck + 8 
   165  E2 		= 21500*(fcm/10)**(1/3)		    					 
   166  !************************************************************!  
   167  !****_ 		2.4 Condições de Contorno	  	_****!  
   168  !************************************************************!  
   169  prx 		= 9 		! [MPa] tensões iniciais na direção x
   170  pry		= 9		! [MPa] tensões iniciais na direção y  
   171  prz		= 9		! [MPa] tensões iniciais na direção z  
   172  !   
   173  !************************************************************!  
   174  !****_ 		2.5 Discretização do tempo nos passos	_****! 
   175  !************************************************************!  
   176  !   
   177  ! Discretização do tempo durante os passos de escavação tunel longitudinal  
   178  tp 		= Lp/(Vp) 	! [dias] tempo para fazer um passo de escavação nos tuneis longitudinais  
   179  dtp 		= 0.5*tp	! [dias] incremento de tempo inicial dentro de cada passo
   180  dtpmax 		= dtp 		! [dias] incremento máximo de tempo dentro de cada passo  
   181  !   
   182  ! Discretização do tempo durante os passos de escavação da galeria  
   183  tp1 		= Lp1/(Vp1) 	! [dias] tempo para fazer um passo de escavação na galeria transversal 
   184  dtp1		= 0.5*tp1	! [dias] incremento de tempo inicial dentro de cada passo   
   185  dtpmax1		= dtp1		! [dias] incremento máximo de tempo dentro de cada passo  
   186  !   
   187  ! Discretização do tempo nos passos após a escavação   
   188  tp2 		= 100 		! [dias] tempo de cada passo de solução após a escavação do túnel   
   189  np2max 		= 30 		! [un] número máximo de passos de solução após a escavação do túnel 
   190  dtp2		= 0.5*tp2	! [dias] incremento de tempo de cada passo  
   191  !   
   192  tp2autots	= 1		! Especifica quando usar incremento de tempo automático 
   193  !				!      -1 - O programa escolhe 
   194  !				! 	0 - não usa incremento de tempo automático (usa apenas dtp2)  
   195  !				!	1 - usa incremento de tempo automático (usa o dpt2min e dpt2max)
   196  tp2carry	= 1		! Incremento de tempo entre passos
   197  !				!	0 - usa o dtp2 como o incremento de tempo em cada passo  
   198  !				!	1 - usa o incremento de tempo do passo anterior em cada passo (se dtp2autots = 1)
   199  dtp2min		= tp2/2		! [dias] incremento mínimo de tempo de cada passo
   200  dtp2max		= tp2		! [dias] incremento máximo de tempo de cada passo				! 
   201  !   
   202  deltaumin	= 1E-8		! [adm] critério de convergência no tempo   
   203  !   
   204  !************************************************************!  
   205  !****_ 		2.6 Discretização da malha              _****!   
   206  !************************************************************!  
   207  tipoelem 	= 1 		! elementos fora da região da galeria: 1 - SOLID185, 2 - SOLID186  
   208  formaint	= 0		! integração 0 - completa, 1 - reduzida 
   209  tipoelem1 	= 2 		! elementos na região da galeria: 1 - SOLID185, 2 - SOLID186  
   210  formaint1	= 0		! integração 0 - completa, 1 - reduzida
   211  !   
   212  nLp		= 1		! [un] numero de elementos no passo escavado do túnel longitudinal   
   213  nLp1		= 2 		! [un] numero de elementos no passo escavado da galeria 
   214  nL1 		= 15 		! [un] numero de elementos ao longo do eixo do tunel longitudinal no trecho não escavado  
   215  mL1 		= 1/5 		! [adm] taxa de crescimento   
   216  nesp 		= 1 		! [un] numero de elementos na espessura do revestimento do tunel longitudinal  
   217  nCRe 		= 16 		! [un] numero de elementos na interface entre maciço e o revestimento do tunel longitudinal (deve ser par)   
   218  nRi 		= nCRe/2 	! [un] numero de elementos na horizontal e vertical do maciço escavado no tunel longitudinal   
   219  mRi 		= 0 		! [adm] taxa de crecimento  
   220  nd3 		= nCRe/2 	! [un] numero de elementos na horizontal e vertical oposta ao tunel longitudinal
   221  m4ga		= Lp1/1.3 	! [m] tamanho dos elementos na galeria 
   222  !   
   223  *IF,d1,EQ,16,THEN   
   224  	nd1 		= 18		! 16 [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal (exemplo: 6, 8, 12)  
   225  	md1 		= 20 		! 16 [adm] taxa de crescimento (exmeplo: 5, 8, 10)		  
   226  	nd4 		= 5 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal  
   227  	md4 		= 1.5 		! [adm] taxa de crescimento  
   228  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   229  	md6		= md1		! [adm] taxa de crescimento
   230  	nd5		= 12		! 8 [un] numero de elementos no trecho adjacente a galeria transversal (exemplo: 6, 8)  
   231  	md5		= 4		! 3 [adm] taxa de crescimento (exemplo: 2, 6)
   232  *ELSEIF,d1,EQ,4,THEN
   233  	nd1 		= 7		! [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal  
   234  	md1 		= 5 		! [adm] taxa de crescimento		  
   235  	nd4 		= 12 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal 
   236  	md4 		= 6 		! [adm] taxa de crescimento
   237  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   238  	md6		= md1		! [adm] taxa de crescimento
   239  	nd5		= 6		! [un] numero de elementos no trecho adjacente a galeria transversal 
   240  	md5		= 4		! [adm] taxa de crescimento  
   241  *ELSEIF,d1,EQ,5,THEN
   242  	nd1 		= 9		! [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal  
   243  	md1 		= 7 		! [adm] taxa de crescimento		  
   244  	nd4 		= 12 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal 
   245  	md4 		= 6 		! [adm] taxa de crescimento
   246  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   247  	md6		= md1		! [adm] taxa de crescimento
   248  	nd5		= 6		! [un] numero de elementos no trecho adjacente a galeria transversal 
   249  	md5		= 4		! [adm] taxa de crescimento  
   250  *ELSEIF,d1,EQ,8,THEN
   251  	nd1 		= 14		! [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal 
   252  	md1 		= 10 		! [adm] taxa de crescimento		 
   253  	nd4 		= 12 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal 
   254  	md4 		= 6 		! [adm] taxa de crescimento
   255  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   256  	md6		= md1		! [adm] taxa de crescimento
   257  	nd5		= 8		! [un] numero de elementos no trecho adjacente a galeria transversal 
   258  	md5		= 6		! [adm] taxa de crescimento	 
   259  *ELSEIF,d1,EQ,3,THEN
   260  	nd1 		= 5		! [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal  
   261  	md1 		= 5 		! [adm] taxa de crescimento		  
   262  	nd4 		= 10 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal 
   263  	md4 		= 3 		! [adm] taxa de crescimento
   264  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   265  	md6		= md1		! [adm] taxa de crescimento
   266  	nd5		= 6		! [un] numero de elementos no trecho adjacente a galeria transversal 
   267  	md5		= 4		! [adm] taxa de crescimento  
   268  *ENDIF	 
   269  !   
   270  !************************************************************!  
   271  !****_ 		2.7 Configuração da saida de dados    	_****!
   272  !************************************************************!  
   273  teta		= 90		! angulo da posição do perfil de convergências no túnel longitudinal
   274  direcao 	= 'Y'		! componente dos deslocamentos para o perfil de convergências										    						  
   275  iso		= 0 		! 0 - contorno padrão, 1 - isolinhas (apenas 0 se isosup=1) 
   276  flag1 		= 1 		! 1 - saida jpg do gráfico de convergência em arquivo   
   277  flag2 		= 1 		! 1 - saida txt de resultados do gráfico de convergênci 
   278  flag3 		= 1 		! 1 - saida do gráfico de convergência na tela do Ansys 
   279  !   
   280  ! Obs: os arquivos de imagem jpg saem com o nome jobname###.jpg 
   281  ! onde ### é um inteiro que vai incrementando a partir da última  
   282  ! numeração do último arquivo plotado.   
   283  ! Os campos de resultados serão referentes ao final da análise.   
   284  !   
   285  !***********************************************************!   
   286  !****_ 		2.8 Configurações da solução	     	_****!  
   287  !***********************************************************!   
   288  !   
   289  nr	= 2	! Tipo de Newton-Raphson 
   290  !		! 1 - INIT rigidez não é atualizada
   291  !		! 2 - FULL rigidez atualizada a cada iteração  
   292  !		! 3 - UNSYM assimétrica atualizada a cada iteração
   293  !   
   294  ! Tolerâncias durante os passos de escavação do túnel longitudinal  
   295  tolf	= 1e-6	! tolerância para o resíduo (padrão 0.005)   
   296  tolu	= 1e-4	! tolerância para o incremento de deslocamento (padrão 0.05)  
   297  !   
   298  ! Tolerâncias durante os passos de escavação da galeria transversal  
   299  tolf1	= 1e-6	! tolerância para o resíduo  
   300  tolu1	= 1e-4	! tolerância para o incremento de deslocamento
   301  !   
   302  ! Tolerâncias durante os passos após a construção do túnel 
   303  tolf2	= 1e-6	! tolerância para o resíduo  
   304  tolu2	= 1e-4	! tolerância para o incremento de deslocamento
   305  !   
   306  ! Tolerância para o incremento de deformação plástica equivalente   
   307  plslimit = 0.99 
   308  !   
   309  psc	= 1	! 1 - Ativa, 0 - desativa a opção de paralelização SMP  
   310  nlg	= 0	! 1 - Ativa, 0 - desativa a não lineariedade geométrica   
   311  soleq	= 0	! 1 - calcula o equilibrio do maciço antes de iniciar
   312  !   
   313  !   
   314  !************************************************************!  
   315  !****_ 		2.9 Titulo e nome dos arquivos  	_****!
   316  !************************************************************!  
   317  ! defini titulo na tela do Ansys
   318  /TITLE, Re=%Re% matmacico=%matmacico% E1=%E1% pr=%pr% matrev=%matrev% E2=%E2% vp=%vp%   
   319  !   
   320  ! define nome file.* para os arquivos da analise
   321  /FILNAME,file,0 
   322  !   
   323  !   
   324  !   
   325  !   
   326  !------------------FIM ENTRADA DE DADOS---------------------!   
   327  !   
   328  !   
   329  !   
   330  !   
   331  !************************************************************!  
   332  !****_ 3. PRÉ-PROCESSAMENTO 				_****! 
   333  !************************************************************!  
   334  /PREP7 ! inicia módulo de pré-processamento   
   335  !   
   336  !************************************************************!  
   337  !****_ 		3.1 Calculos iniciais			_****! 
   338  !************************************************************!  
   339  ri 		= re-esp		! [m] raio da face interna do revestimento dos tuneis longitudinais  
   340  l1		= l1*Re    		! [m] comprimento do trecho não escavado  
   341  l2		= l2*Lp			! [m] comprimento do trecho escavado  
   342  lt 		= l1+l2 		! [m] comprimento total do modelo ao longo do eixo longitudinal  
   343  d1 		= d1*Re			! [m] distância entre eixos dos túneis longitudinais (d1 = 16*Re ou d1 = 4*Re) 
   344  d4 		= d4*re 		! [m] distância das bordas laterais do domínio até o eixo do tunel longitudinal   
   345  l3 		= (d1/2+d4)*2 		! [m] dimensão transversal do modelo  
   346  d3		= d3*Re			! [m] altura do domínio (profundidade do eixo do túnel longitudinal)
   347  d5		= d5*Lp			! [m] distância adjacente a galeria com malha livre (exemplo: 1, 2, 4, 6)
   348  np	 	= l2/Lp 		! [un] numero total passos escavados nos tuneis longitudinais
   349  nesc 		= np-npi+1 		! [un] total de escavações ao longo do eixo do tunel longitudinal 
   350  d0		= nd0*lp		! [m] dimensão não suportada (multiplo do passo)
   351  !   
   352  ri1 		= re1-esp1 		! [m] raio da face interna do revestimento das galerias transversais 
   353  d2 		= l2/2 			! [m] posição da galeria ao longo do eixo longitudinal 
   354  d01		= nd01*Lp1		! [m] [m] dimensão não suportada da galeria (multiplo do passo)  
   355  np1 		= (d1/2-re)/Lp1 	! [un] total de passos escavados nas galerias transversais   
   356  nesc1 		= NINT(np1-npi1+1) 		! [un] total de escavações ao longo do eixo das galerias transversais
   357  !pig1 		= pig1+l2/(2*Lp)	! [un] numero de passos de escavação no túnel longitudinal no qual iniciará a escavação da galeria 1 
   358  !   
   359  nescinig		= np/2-npi+1+re1/Lp+pig1	! [un] numero da escavação em que se inicia a galeria  
   360  !   
   361  m1		= Lp/nLp 		! [m] tamanho do elemento ao longo do eixo do tunel longitudinal no trecho escavado  
   362  m9 		= m1 			! [m] tamanho dos elementos na região do tunel oposta a galeria   
   363  !   
   364  vpi = 3.14159265358979323846
   365  !   
   366  ! caso não haja escavação na galeria 
   367  *IF,escavagaleria,EQ,0,THEN 
   368  	nesc1 = 0  
   369  *ENDIF  
   370  !   
   371  ! verificando se haverá análise após a construção do túnel
   372  analise2 = 0
   373  *IF,matmacico,GT,6,OR,matrev,GT,1,THEN  
   374  	analise2 = 1   
   375  *ENDIF  
   376  *IF,matmacico,EQ,23,THEN
   377  	analise2 = 1   
   378  *ENDIF  
   379  !   
   380  !************************************************************!  
   381  !****_ 		3.2 Elementos finitos 			_****!
   382  !************************************************************!  
   383  *IF,tipoelem,EQ,1,THEN  
   384  	ET,1,SOLID185  
   385  	KEYOPT,1,2,formaint
   386  	KEYOPT,1,3,0   
   387  	KEYOPT,1,6,0   
   388  	KEYOPT,1,8,0   
   389  *ELSEIF,tipoelem,EQ,2,THEN  
   390  	ET,1,SOLID186  
   391  	KEYOPT,1,2,formaint
   392  	KEYOPT,1,3,0   
   393  	KEYOPT,1,6,0   
   394  	KEYOPT,1,8,0   
   395  *ENDIF  
   396  !   
   397  *IF,tipoelem1,EQ,1,THEN 
   398  	ET,2,SOLID185  
   399  	KEYOPT,2,2,formaint1   
   400  	KEYOPT,2,3,0   
   401  	KEYOPT,2,6,0   
   402  	KEYOPT,2,8,0   
   403  *ELSEIF,tipoelem1,EQ,2,THEN 
   404  	ET,2,SOLID186  
   405  	KEYOPT,2,2,formaint1   
   406  	KEYOPT,2,3,0   
   407  	KEYOPT,2,6,0   
   408  	KEYOPT,2,8,0   
   409  *ENDIF  
   410  !   
   411  !************************************************************!  
   412  !****_ 		3.3 Material do maciço 			_****!  
   413  !************************************************************!  
   414  *IF,matmacico,eq,1,then 
   415  	! Definindo o material elastico do Ansys   
   416  	MPTEMP,1,0  		 
   417  	MPDATA,EX,1,,E1	   
   418  	MPDATA,PRXY,1,,nu1 	   
   419  *ELSEIF,matmacico,eq,2,then 
   420  	! Definindo o material elastoplástico VM do Ansys bilienar
   421  	yield	    	= 2*c1			! [MPa]	tensão de escoamento  
   422  	Ep 		= 2*(c2-c1)/(eps1)	! [MPa] módulo plástico tangente 
   423  	youngt      	= Ep*E1/(E1+Ep)		! [MPa] módulo de elastoplástico tangente  
   424  	!  
   425  	MPTEMP,1,0  		 
   426  	MPDATA,EX,1,,E1	   
   427  	MPDATA,PRXY,1,,nu1 	   
   428  	TB,BISO,1,1,2, 
   429  	TBTEMP,0   
   430  	TBDATA,,yield,youngt,,,,   
   431  *ELSEIF,matmacico,eq,22,then
   432  	! Definindo o material elastoplástico VM do Ansys multilinear 
   433  	yield	    	= 2*c1			! [MPa]	tensão de escoamento  
   434  	Ep 		= 2*(c2-c1)/(eps1)	! [MPa] módulo plástico tangente 
   435  	youngt      	= Ep*E1/(E1+Ep)		! [MPa] módulo de elastoplástico tangente  
   436  	epst0		= 2*c1/E1		! [adm] deformação total no escoamento 
   437  	epst1		= 2*c2/E1 + eps1 	! [adm] deformação total na zona 1  
   438  	epst2		= 2*c2/E1 + eps2	! [adm] deformação total na zona 2	  
   439  	epst3		= 2*c3/E1 + eps3	! [adm] deformação total na zona 3   
   440  	!  
   441  	MPTEMP,1,0  		 
   442  	MPDATA,EX,1,,E1	   
   443  	MPDATA,PRXY,1,,nu1 	   
   444  	TB,MISO,1,1,5,0
   445  	TBTEMP,0   
   446  	TBPT,,epst0,2*c1   
   447  	TBPT,,epst1,2*c2   
   448  	TBPT,,epst2,2*c2   
   449  	TBPT,,epst3,2*c3   
   450  	TBPT,,0.1,2*c3 
   451  *ELSEIF,matmacico,eq,23,then
   452  	! Definindo o material viscoplastico perzyna VM do Ansys   
   453  	yieldvp	    	= 2*cvp				! [MPa]	tensão de escoamento  
   454  	youngtvp      	= 0				! [MPa] módulo de elastoplástico tangente  
   455  	gamma	      	= ((yieldvp/f0)**n1)/eta 	! [dias^-1] coeficiente Gamma do modelo de Perzyna Ansys
   456  	m  	      	= 1/n1				! [adm] coeficiente m do modelo de Perzyna do ANSYS   
   457  	!  
   458  	MPTEMP,1,0  		 
   459  	MPDATA,EX,1,,E1	   
   460  	MPDATA,PRXY,1,,nu1	
   461  	TB,BISO,1,1,2, 
   462  	TBTEMP,0   
   463  	TBDATA,,yieldvp,youngtvp,,,,   
   464  	TB,RATE,1,1,2,1
   465  	TBTEMP,0   
   466  	TBDATA,,m,gamma,,,,	   
   467  *ELSEIF,matmacico,eq,4,then 
   468  	! Definindo material usermat3D VM do Ansys 
   469  	yield	    	= 2*c1			! [MPa]	tensão de escoamento  
   470  	Ep 		= 2*(c2-c1)/(eps1)	! [MPa] módulo plástico tangente 
   471  	youngt      	= Ep*E1/(E1+Ep)		! [MPa] módulo de elastoplástico tangente  
   472  	!  
   473  	TB,USER,1,2,5  
   474  	TBTEMP,1.0 		  
   475  	TBDATA,1,matmacico,E1,nu1,yield,youngt ! modelo, E, posn, sigy, H  
   476  	TB,STATE,1,,8  
   477  *ELSEIF,matmacico,eq,5,then 
   478  	! Definindo material usermat3D_elastico
   479  	TB,USER,1,2,3  
   480  	TBTEMP,1.0 		  
   481  	TBDATA,1,matmacico,E1,nu1  
   482  	TB,STATE,1,,8	 
   483  *ELSEIF,matmacico,eq,6,then 
   484  	! Definindo material usermat3D_EP  
   485  	TB,USER,1,2,14 
   486  	TBTEMP,1.0 		  
   487  	TBDATA,1,matmacico,E1,nu1  
   488  	TBDATA,4,superficief,superficieg   
   489  	TBDATA,6,fi,psi,   
   490  	TBDATA,8,c1,c2,c3,eps1,eps2,eps3   
   491  	TBDATA,14,Dalg 
   492  	TB,STATE,1,,20	
   493  *ELSEIF,matmacico,eq,7,then 
   494  	! Definindo material usermat3D_VP  
   495  	TB,USER,1,2,13 
   496  	TBTEMP,1.0 		  
   497  	TBDATA,1,matmacico,E1,nu1  
   498  	TBDATA,4,superficiefvp,superficiegvp   
   499  	TBDATA,6,fivp,psivp,   
   500  	TBDATA,8,cvp,n1,eta,f0,thetavp	
   501  	TB,STATE,1,,20		   
   502  *ELSEIF,matmacico,eq,8,then 
   503  	! Definindo material usermat3D_EPVP
   504  	TB,USER,1,2,23 
   505  	TBTEMP,1.0 		  
   506  	TBDATA,1,matmacico,E1,nu1  
   507  	TBDATA,4,superficief,superficieg   
   508  	TBDATA,6,fi,psi,   
   509  	TBDATA,8,c1,c2,c3,eps1,eps2,eps3   
   510  	TBDATA,14,Dalg 
   511  	TBDATA,15,superficiefvp,superficiegvp  
   512  	TBDATA,17,fivp,psivp   
   513  	TBDATA,19,cvp  
   514  	TBDATA,20,n1,eta,f0
   515  	TBDATA,23,thetavp	 
   516  	TB,STATE,1,,20 
   517  *ENDIF  
   518  !   
   519  !************************************************************!  
   520  !****_ 		3.4 Material do revestimento		_****!   
   521  !************************************************************!  
   522  *IF,matrev,EQ,1,THEN
   523  	*DO,i,2,nesc+nesc1,1   
   524  		MPTEMP,1,0  				  
   525  		MPDATA,EX,i,,E2				   
   526  		MPDATA,PRXY,i,,nu2
   527  	*ENDDO 			 
   528  *ELSEIF,matrev,EQ,2,THEN
   529  	*DO,i,2,nesc+nesc1,1   
   530  		TB,USER,i,1,18
   531  		TBTEMP,1.0
   532  		TBDATA,1,9
   533  		TBDATA,2,ligafluencia,ligaretracao
   534  		! 
   535  		*IF,escavagaleria,EQ,1,THEN   
   536  			*IF,i,LT,nesc+nesc1,THEN 
   537  				TBDATA,4,npi*tp+tp*(i-2)
   538  				TBDATA,10,s,rh,hf,betasc,alpha  
   539  			*ELSE
   540  				TBDATA,4,tp*nesc + tp1*np1 + tp1*(i-2)  
   541  				TBDATA,10,s,rh,hf1,betasc,alpha 
   542  			*ENDIF   
   543  		*ELSE 
   544  			TBDATA,4,npi*tp+tp*(i-2) 
   545  			TBDATA,10,s,rh,hf,betasc,alpha   
   546  		*ENDIF
   547  		! 
   548  		TBDATA,5,ts,t0,tinf   
   549  		TBDATA,8,fck,nu2  
   550  		TBDATA,15,ndec
   551  		TBDATA,16,ktime,kelemid,kkDomIntPt
   552  		TB,STATE,i,,500   
   553  	*ENDDO	
   554  *ENDIF  
   555  !   
   556  !************************************************************!  
   557  !****_ 		3.5 Modelando o sólido			_****!   
   558  !************************************************************!  
   559  !   
   560  ! Definindo a vista 
   561  /VIEW,1,1,1,1   
   562  /ANG,1  
   563  !   
   564  ! criando bloco e casca cilindrica do trecho não escavado  
   565  BLC4,-d4,0,l3/2,d3,l1   
   566  CYL4,0,0,ri,0,re,180,l1 
   567  !   
   568  ! criando bloco e casca cilindrica do trecho que será escavado 
   569  WPOFFS,0,0,l1   
   570  BLC4,-d4,0,l3/2,d3,l2   
   571  CYL4,0,0,ri,0,re,180,l2 
   572  !   
   573  ! excluindo volumes em comum
   574  VPTN,ALL
   575  !   
   576  ! tolerancia para operações booleanas 
   577  BTOL,1E-4   
   578  !   
   579  ! dividindo os volumes no plano vertical do eixo do tunel principal 
   580  WPOFFS,0,0,0
   581  WPRO,,,90.000000
   582  VSBW,ALL
   583  !   
   584  ! dividindo o volume entre tuneis na altura 
   585  VSEL,ALL
   586  VSEL,S,LOC,X,0,d1/2 
   587  WPOFFS,0,d1/2,0 
   588  WPRO,,90,   
   589  VSBW,ALL
   590  !   
   591  ! criando o mesmo volume no lado oposto do plano vertical do eixo do tunel  
   592  VSEL,ALL
   593  VSEL,S,LOC,X,0,d1/2 
   594  VSEL,R,LOC,Y,0,d1/2 
   595  CSYS,1  
   596  VSEL,U,LOC,X,0,re   
   597  CSYS,0  
   598  VSYMM,X,ALL, , ,0,1,0   
   599  !   
   600  ! criando primeiro tunel transversal
   601  WPAVE,0,0,0 
   602  WPCSYS,-1,0 
   603  WPOFFS,0,0,lt-d2/2		
   604  WPRO,,,90   
   605  CYL4,0,0,ri1,0,re1,180,d1/2 
   606  !   
   607  ! criando plano de corte da galeria transversal 
   608  CSYS,1  
   609  VSEL,ALL
   610  VSEL,S,LOC,Z,l1,lt  
   611  VSEL,R,LOC,X,ri/2,re
   612  ASEL,S,EXT  
   613  CSYS,1  
   614  ASEL,R,LOC,X,re,re  
   615  ASEL,R,LOC,Z,l1+l2/2,l1+l2/2
   616  CM,A0,AREA  
   617  !   
   618  ! cortando a galeria transversal
   619  CSYS,0  
   620  ALLSEL,ALL  
   621  VSEL,S,LOC,Z,lt-d2/2+re1,lt-d2/2-re1
   622  VSBA,ALL,A0 
   623  !   
   624  ! deletando trecho da galeria transversal dentro do tunel longitudinal  
   625  ALLSEL,ALL  
   626  WPAVE,0,0,0 
   627  WPCSYS,-1,0 
   628  VSEL,S,LOC,Z,lt-d2/2,lt-d2/2
   629  VSEL,R,LOC,X,0,re   
   630  VSEL,R,LOC,Y,0,re1  
   631  VDELE,ALL,,,1   
   632  !   
   633  ! Alterando posição da galeria para a metade de L2
   634  ALLSEL,ALL  
   635  WPAVE,0,0,0 
   636  WPCSYS,-1,0 
   637  VSEL,S,LOC,Z,lt-d2/2,lt-d2/2
   638  VSEL,R,LOC,X,re,d1/2
   639  VSEL,R,LOC,Y,0,re1  
   640  VGEN, ,ALL, , , , ,-d2/2, , ,1  
   641  !   
   642  ! cortando trecho do tunel principal
   643  VSEL,ALL
   644  WPAVE,0,0,0 
   645  WPCSYS,-1,0 
   646  WPOFFS,0,0,(lt-l2/2)+re1+d5		   
   647  VSBW,ALL
   648  WPOFFS,0,0,-2*re1-2*d5  
   649  VSBW,ALL
   650  !   
   651  ! particionando outros volumes  
   652  VSEL,ALL
   653  VPTN,ALL
   654  !   
   655  ! Cortando no meio da galeria   
   656  VSEL,ALL
   657  WPAVE,0,0,0 
   658  WPCSYS,-1,0 
   659  VSEL,S,LOC,Z,lt-l2/2-d5,lt-l2/2+d5  
   660  WPOFFS,0,0,lt-l2/2  
   661  VSBW,ALL
   662  !   
   663  ! Deletando os volumes na metade da galeria 
   664  VSEL,ALL
   665  WPAVE,0,0,0 
   666  WPCSYS,-1,0 
   667  VSEL,S,LOC,Z,l1+l2/2,l1+l2/2-re1-d5 
   668  VSEL,R,LOC,X,-d1/2,d1/2 
   669  VSEL,R,LOC,Y,0,d1/2 
   670  VDELE,ALL,,,1   
   671  !   
   672  ! juntando pontos duplicados
   673  ALLSEL,ALL  
   674  NUMMRG,KP, , , ,LOW 
   675  !   
   676  ! renumerando a geometria   
   677  NUMCMP,KP   
   678  NUMCMP,LINE 
   679  NUMCMP,AREA 
   680  NUMCMP,VOLU 
   681  !   
   682  !************************************************************!  
   683  !****_ 		3.6 Divisões para a malha nas linhas 	_****!  
   684  !************************************************************!  
   685  !   
   686  ! tamanho do elemento ao longo do eixo do tunel longitudinal no trecho escavado (parte a frente da galeria) 
   687  CSYS,0  
   688  LSEL,ALL
   689  LSEL,S,LOC,Z,lt-0.01,lt-l2/2+re1+d5+0.01
   690  LSEL,R,LOC,X,-d4,d1/2   
   691  LSEL,R,LOC,Y,0,d3   
   692  LESIZE,ALL,m1, , , , , , ,1 
   693  !   
   694  ! tamanho do elemento ao longo do eixo do tunel longitudinal no trecho escavado (parte anterior a galeria)  
   695  CSYS,0  
   696  LSEL,ALL
   697  LSEL,S,LOC,Z,lt-l2/2-re1-d5-0.01,lt-l2/2-d2+re1+d5+0.01 
   698  LSEL,R,LOC,X,-d4,d1/2   
   699  LSEL,R,LOC,Y,0,d3   
   700  LESIZE,ALL,m1, , , , , , ,1 
   701  !   
   702  ! interface entre solo e revestimento do tunel longitudinal 
   703  CSYS,1  
   704  LSEL,ALL
   705  LSEL,S,LOC,X,0.01,re
   706  LSEL,R,LOC,Y,1,180-1
   707  LSEL,R,LOC,Z,0,lt   
   708  LSEL,U,LOC,Y,89,91  
   709  LSEL,U,LOC,Z,lt-l2/2+re1-0.01,lt-l2/2-re1+0.01  
   710  LESIZE,ALL, , ,nCRe, , , , ,1   
   711  !   
   712  CSYS,1  
   713  LSEL,ALL
   714  LSEL,S,LOC,X,0.01,re
   715  LSEL,R,LOC,Y,1,180-1
   716  LSEL,R,LOC,Z,lt-l2/2,lt-l2/2
   717  LSEL,U,LOC,Y,89,91  
   718  LSEL,U,LOC,Y,0,90   
   719  LESIZE,ALL, , ,nCRe, , , , ,1   
   720  !   
   721  CSYS,1  
   722  LSEL,ALL
   723  LSEL,S,LOC,X,0.01,ri
   724  LSEL,R,LOC,Y,1,89   
   725  LSEL,R,LOC,Z,lt-l2/2,lt-l2/2
   726  LESIZE,ALL, , ,nCRe, , , , ,1   
   727  !   
   728  ! horizontal e vertical dentro do túnel longitudinal   
