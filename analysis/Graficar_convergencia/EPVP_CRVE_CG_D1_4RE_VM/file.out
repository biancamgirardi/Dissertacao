  2167  		EKILL,ALL 
  2168  	*ENDIF 
  2169  *ENDIF  
  2170  !   
  2171  ! Verifica o equilibrio do maciço  
  2172  *IF,soleq,EQ,1,THEN 
  2173  	ANTYPE,0,NEW   
  2174  	ESEL,ALL   
  2175  	TIME,1 
  2176  	DELTIM,1,,1
  2177  	!CNVTOL,F,,tolf,,0.01  
  2178  	!CNVTOL,U,,tolu
