  1947  !************************************************************!  
  1948  !****_ 		3.13 Criando elementos do revestimento	_****!  
  1949  !************************************************************!  
  1950  ! Obs: esses elementos ficam sobrepostos ao do solo. Durante
  1951  ! a análise, conforme vai desligando os elementos do   
  1952  ! macicço vai-se ligando os do resvestimento, se houver.   
  1953  !   
  1954  *IF,matrev,NE,0,THEN
  1955  	CMSEL,S,Casca1,ELEM
  1956  	EGEN,2,0,ALL,ALL,1,1,,,,0,0,0  
  1957  	ESEL,ALL   
  1958  	NUMMRG,NODE, , , ,LOW  
  1959  	ESEL,MAT,2 
  1960  	CM,Revestimento1,ELEM  
  1961  *ENDIF  
  1962  !   
  1963  *IF,matrev,NE,0,THEN
  1964  	CMSEL,S,Casca2,ELEM
  1965  	EGEN,2,0,ALL,ALL,1,1,,,,0,0,0  
  1966  	ESEL,ALL   
  1967  	NUMMRG,NODE, , , ,LOW  
  1968  	ESEL,MAT,2 
  1969  	CMSEL,U,Revestimento1,ELEM 
  1970  	CM,Revestimento2,ELEM  
  1971  *ENDIF  
  1972  !   
  1973  !************************************************************!  
  1974  !****_ 		3.14 Grupos Esc-rev tunel longitudinal 	_****! 
  1975  !************************************************************!  
  1976  !   
  1977  ! Primeira escavação  
  1978  i = 1   
  1979  LOCAL,11,1,0,0,lt,0,0,180,0 
  1980  ESEL,ALL
  1981  fi=0
  1982  ff=npi*Lp   
  1983  ESEL,S,CENT,Z,fi,ff 
  1984  ESEL,R,CENT,X,0,re  
  1985  ESEL,R,CENT,Y,0,180 
  1986  CM,Lesc %i%,ELEM
  1987  CMSEL,S,Lesc %i%,ELEM   
  1988  !   
  1989  ! Proximas escavações e resvestimentos
  1990  *DO,i,2,nesc,1  
  1991  	! criando grupos com os elementos escavados do passo i 
  1992  	fi=ff  
  1993  	ff=(i-1)*Lp+npi*lp 
  1994  	ESEL,S,CENT,Z,fi,ff
  1995  	ESEL,R,CENT,X,0,re 
  1996  	ESEL,R,CENT,Y,0,180
  1997  	CM,Lesc %i%,ELEM   
  1998  	CMSEL,S,Lesc %i%,ELEM  
  1999  	!  
  2000  	*IF,matrev,NE,0,THEN   
  2001  		! criando grupos com os elementos revestidos do passo i   
  2002  		*IF,i,EQ,2,THEN   
  2003  			fi=0 
  2004  		*ELSE 
  2005  			fi=npi*lp+(i-2)*lp-(lp+d0)   
  2006  		*ENDIF
  2007  		ff = (i-1)*lp+npi*lp-(lp+d0)  
  2008  		ESEL,ALL  
  2009  		ESEL,S,CENT,Z,fi,ff   
  2010  		ESEL,R,CENT,X,ri,re   
  2011  		ESEL,R,CENT,Y,0,180   
  2012  		ESEL,R,MAT,,2 
  2013  		MPCHG,i,ALL   
  2014  		CM,Lrev %i-1%,ELEM
  2015  		CMSEL,S,Lrev %i-1%,ELEM   
  2016  	*ENDIF 
  2017  	!  
  2018  	! revestindo o ultimo trecho   
  2019  	*IF,i,EQ,nesc,THEN 
  2020  		*IF,matrev,NE,0,THEN  
  2021  			*IF,revested0,EQ,1,THEN  
  2022  				fi=l2-lp-d0 
  2023  				ff=l2   
  2024  				ESEL,S,CENT,Z,fi,ff 
  2025  				ESEL,R,CENT,X,ri,re 
  2026  				ESEL,R,CENT,Y,0,180 
  2027  				ESEL,R,MAT,,2   
  2028  				MPCHG,i,ALL 
  2029  				CM,Lrev %i%,ELEM
  2030  				CMSEL,S,Lrev %i%,ELEM   
  2031  			*ENDIF   
  2032  			*IF,revesteface,EQ,1,THEN
  2033  				fi=l2   
  2034  				ff=l2+(lp)  
  2035  				ESEL,ALL
  2036  				ESEL,S,CENT,Z,fi,ff 
  2037  				ESEL,R,CENT,X,0,re  
  2038  				ESEL,R,CENT,Y,0,180 
  2039  				CM,soloface,ELEM
  2040  				CMSEL,S,soloface,ELEM   
  2041  				!   
  2042  				fi=l2   
  2043  				ff=l2+lp
  2044  				ESEL,ALL
  2045  				ESEL,S,CENT,Z,fi,ff 
  2046  				ESEL,R,CENT,X,0,re  
  2047  				ESEL,R,CENT,Y,0,180 
  2048  				EGEN,2,0,all,all,1,1,,,,0,0,0   
  2049  				NUMMRG,node, , , ,LOW   
  2050  				ESEL,R,MAT,,2   
  2051  				MPCHG,i,ALL 
  2052  				CM,Lrevface,ELEM
  2053  				CMSEL,S,Lrevface,ELEM   
  2054  			*ENDIF   
  2055  		*ENDIF
  2056  	*ENDIF 
  2057  *ENDDO  
  2058  !   
  2059  ! criando grupo de elementos escavados  
  2060  ESEL,S,CENT,Z,0,l2  
  2061  ESEL,R,CENT,X,0,re  
  2062  ESEL,R,CENT,Y,0,180 
  2063  CM,esctotallongitudinal,ELEM
  2064  CSYS,0  
  2065  !   
  2066  !********************************************************************************************!  
  2067  !****_ 		3.15 Grupos esc-rev das galerias	_****!
  2068  !********************************************************************************************!  
  2069      
  2070  !   
  2071  ! Primeira escavação da primeira galeria  
  2072  i = 1   
  2073  LOCAL,12,1,re,0,lt-l2/2,0,0,90  
  2074  fi=-re  
  2075  ff=npi1*Lp1 
  2076  ESEL,ALL
  2077  CMSEL,S,VG1,VOLUME  
  2078  ESLV,S  
  2079  ESEL,R,CENT,Z,fi,ff 
  2080  ESEL,R,CENT,X,0,re1 
  2081  ESEL,R,CENT,Y,0,180 
  2082  CM,T1esc %i%,ELEM   
  2083  CMSEL,S,T1esc %i%,ELEM  
  2084  !   
  2085  ! criando grupo da entrada da galeria 1 
  2086  *IF,matrev,NE,0,THEN
  2087  	ESEL,ALL   
  2088  	CMSEL,S,Revestimento1,ELEM 
  2089  	ESEL,R,CENT,Z,fi,ff
  2090  	ESEL,R,CENT,X,0,re1-0.01   
  2091  	ESEL,R,CENT,Y,0,180
  2092  	CM,T1escent,ELEM   
  2093  	CMSEL,S,T1escent,ELEM  
  2094  *ENDIF  
  2095  !   
  2096  ! Proximas escavações e resvestimentos da primeira galeria
  2097  *IF,escavagaleria,EQ,1,THEN 
  2098  	*DO,i,2,nesc1,1
  2099  		fi=npi1*Lp1+(i-2)*Lp1 
  2100  		ff=npi1*Lp1+(i-1)*Lp1 
  2101  		ESEL,S,CENT,Z,fi,ff   
  2102  		ESEL,R,CENT,X,0,re1-0.01  
  2103  		ESEL,R,CENT,Y,0,180   
  2104  		CM,T1esc %i%,ELEM 
  2105  		CMSEL,S,T1esc %i%,ELEM
  2106  		! 
  2107  		*IF,matrev,NE,0,THEN  
  2108  			! criando grupos com os elementos revestidos do passo i  
  2109  			*IF,i,EQ,2,THEN  
  2110  				fi=-re  
  2111  			*ELSE
  2112  				fi=(i-2)*Lp1
  2113  			*ENDIF   
  2114  			*IF,i,EQ,nesc1,THEN  
  2115  				ff=l2/2-re  
  2116  			*ELSE
  2117  				ff=npi1*Lp1+(i-2)*Lp1-d01   
  2118  			*ENDIF   
  2119  			ESEL,ALL 
  2120  			CMSEL,S,Revestimento2,ELEM   
  2121  			ESEL,R,CENT,Z,fi,ff  
  2122  			ESEL,R,CENT,X,ri1,re1-0.01   
  2123  			ESEL,R,CENT,Y,0,180  
  2124  			MPCHG,nesc-1+i,ALL   
  2125  			CM,T1rev %i-1%,ELEM  
  2126  			CMSEL,S,T1rev %i-1%,ELEM 
  2127  		*ELSE 
  2128  			! não aplica revestimento   
  2129  		*ENDIF
  2130  	*ENDDO 
  2131  *ENDIF  
  2132  CSYS,0  
