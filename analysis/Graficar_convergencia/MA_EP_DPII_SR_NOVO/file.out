     1  !************************************************************!  
     2  !** PROGRAMA ANÁLISE TUNEL DUPLO (MODELO 3D) 		   **!  
     3  !** Versão: 2023.17 					   **!
     4  !** 							   **!   
     5  !** Objetivo: faz análise da convergência de túneis 	   **!  
     6  !** profundos com seção circular dupla (gêmeos)		   **!  
     7  !** com/sem galerias transversais			   **!  
     8  !** considerando um modelo 3D 				   **!
     9  !** 							   **!   
    10  !** Programador: Felipe Quevedo e Carlos Alberto	   **! 
    11  !** Situação : OK (11/07/2020) 				   **! 
    12  !** Unidades : [F/A, L, t] = MPa, m, dias		   **!   
    13  !** 							   **!   
    14  !************************************************************!  
    15  !   
    16  !************************************************************!  
    17  !****_ 1. INICIALIZANDO O ANSYS 		        _****!
    18  !************************************************************!  
    19  FINISH  
    20  /CLEAR,NOSTART  
    21  !   
    22  !************************************************************!  
    23  !****_ 2. DADOS DE ENTRADA DO PROBLEMA 			_****!
    24  !************************************************************!  
    25  !   
    26  ! Nessa seção define-se todos os dados de entrada necessarios 
    27  !   
    28  !************************************************************!  
    29  !****_ 		2.1 Parâmetros geométricos		_****!   
    30  !************************************************************!  
    31  ! referente aos tuneis longitudinais
    32  Re 		= 1 		! [m] raio da interface entre o túnel e o maciço   
    33  esp		= 0.1		! [m] espessura do revestimento 
    34  Lp 		= 1/3*Re 	! [m] comprimento do passo de escavação
    35  nd0 		= 2 		! [Lp] número de passos que representam a dimensão não suportada 
    36  npi 		= 3 		! [Lp] número de passos escavados na primeira escavação  
    37  Vp 		= 5 		! [m/dia] velocidade do passo de escavação 
    38  revested0 	= 0 		! 0 - não reveste ultimo d0+Lp, 1 - reveste ultimo d0+Lp  
    39  revesteface 	= 0 		! 0 - não reveste a face, 1 - reveste a face
    40  !   
    41  ! referente as galeiras transversais
    42  Re1 		= 2*Lp 		! [m] raio externo da galeria (deve multiplo de Lp)  
    43  esp1		= 0.1		! [m] espessura do revestimento
    44  !Lp1 		= 1/3*re1 	! [m] passo de escavação das galerias transversais (tem que ser multiplo de (d1/2+re))  
    45  nd01 		= 2 		! [Lp1] dimensão não suportada (deve ser multiplo de Lp1)
    46  npi1 		= 3 		! [un] numero de passos escavados na primeira escavação  
    47  Vp1 		= 1 		! [m/dia] velocidade de escavação 
    48  escavagaleria 	= 0 		! escavação das galerias: 0 - não escava, 1 - escava
    49  revestegaleria 	= 0 		! revestimento da galeria: 0 - não reveste, 1 - reveste  
    50  pig1 		= 15 		! [un] numero de passos de escavação a partir da galeria no qual iniciará a escavação da galeria 
    51  !   
    52  ! referente ao restante do domínio 
    53  l1 		= 10 		! [Re] comprimento do trecho não escavado (deve ser suficiente para captar os efeitos na última frente de escavação)
    54  l2 		= 200 		! [Lp] comprimento do trecho escavado  
    55  d3 		= 20 		! [Re] altura do domínio (profundidade do eixo do túnel longitudinal) 
    56  d4 		= 20 		! [Re] distância das bordas laterais do domínio até o eixo do tunel longitudinal 
    57  d1 		= 5		! [Re] distância entre eixos dos túneis longitudinais (d1 = 16*Re ou d1 = 4*Re) 
    58  !   
    59  ! distância adjacente a galeria com malha livre [Lp]   
    60  !   
    61  ! Lp1 deve ter uma medida que se tenha n passos inteiros para se escavar,   
    62  ! portanto: Lp1 = K*Re1 em que K = (d1/2-Re)/(n*Re1).   
    63  ! o valor de d5 é ajustado de modo a ter uma discretização na região da galeria 
    64  !   
    65  !   
    66  *IF,d1,EQ,3,THEN
    67  	d5		= 2
    68  	Lp1		= 0.25*re1
    69  *ELSEIF,d1,EQ,4,THEN
    70  	d5		= 2
    71  	Lp1		= 0.3*re1 
    72  *ELSEIF,d1,EQ,5,THEN
    73  	d5		= 2
    74  	Lp1		= 0.375*re1   
    75  *ELSEIF,d1,EQ,6,THEN
    76  	d5		= 3
    77  	Lp1		= 0.5*re1 
    78  *ELSEIF,d1,EQ,8,THEN
    79  	d5		= 4
    80  	Lp1		= 0.3214*re1	 
    81  *ELSEIF,d1,EQ,10,THEN   
    82  	d5		= 4
    83  	Lp1		= 0.5*re1 
    84  *ELSEIF,d1,EQ,16,THEN   
    85  	d5		= 6			 
    86  	Lp1		= 0.3387*re1  
    87  *ENDIF  
    88  !   
    89  !   
    90  !************************************************************!  
    91  !****_  	2.2 Parâmetros constitutivos do maciço 	_****!   
    92  !************************************************************! 		   
    93  ! Tipo de material do maciço (matmacico)   
    94  !   
    95  ! 	1  - elastico do ANSYS   
    96  ! 	2  - elastoplastico VM do ANSYS (BISO)   
    97  ! 	22 - elastoplastico VM do ANSYS (MISO)   
    98  !	23 - viscoplastico Perzyna VM do ANSYS
    99  !	4  - usermat3D_VM do ANSYS (BISO) 
   100  !	5  - usermat3D_elastico   
   101  !	6  - usermat3D_EP 
   102  !	7  - usermat3D_VP 
   103  !	8  - usermat3D_EPVP	  
   104  !   
   105  matmacico	= 6   
   106  !   
   107  ! Parâmetros de todos os modelos   
   108  E1 		= 20000		 ! [MPa] modulo elasticidade (1,2,22,23,4,5,6,7,8)
   109  nu1 		= 0.3		 ! [adm] coeficiente de poisson (1,2,22,23,4,5,6,7,8)  
   110  !   
   111  ! Parametros para o modelo 2, 22, 6 e 8 
   112  superficief	= 2		 ! função de escoamento: 1-DPI, 2-DPII, 3-DPIII (6,8)
   113  superficieg 	= 2		 ! função potencial: 1-DPI, 2-DPII, 3-DPIII (6,8)   
   114  fi	    	= 30		 ! [graus] angulo de atrito (0 - VM ou TR) (6,8)  
   115  psi	    	= fi		 ! [graus] angulo de dilatância (6,8)   
   116  c1	    	= 5 !*SQRT(3)/2 ! [MPa] coesão inicial (2,22,23,4,6,8) 
   117  c2	    	= 5 !*SQRT(3)/2 ! [MPa] coesão de pico (2,22,23,4,6,8) 
   118  c3	    	= 5 !*SQRT(3)/2 ! [MPa] coesão residual (22,6,8)   
   119  eps1	    	= 0.010		 ! [adm] deformação equiv. limite da zona 1 (22,6,8)   
   120  eps2	    	= 0.010		 ! [adm] deformação equiv. limite da zona 2 (22,6,8)   
   121  eps3	    	= 0.010		 ! [adm] deformação equiv. limite da zona 3 (22,6,8)   
   122  Dalg		= 0		 ! 0 - módulo elastico, 1 - módulo algoritmíco (6,8)  
   123  !   
   124  ! Parametros para o modelo 23, 7 e 8
   125  superficiefvp 	= 2		 ! função de escoamento: 1-DPI, 2-DPII, 3-DPIII (7,8) 
   126  superficiegvp 	= 2		 ! função potencial: 1-DPI, 2-DPII, 3-DPIII (7,8) 
   127  fivp          	= 0		 ! [graus] angulo de atrito (0 - VM ou TR)(7,8) 
   128  psivp         	= fivp		 ! [graus] angulo de dilatância (7,8)   
   129  cvp 	      	= 2*SQRT(3)/2	 ! [MPa] coesão viscoplastica (23,7,8)   
   130  n1	      	= 1		 ! [adm] expoente do modelo de Perzyna (23,7,8)  
   131  eta           	= 4E4 ! [dia] constante de viscosidade dinâmica (23,7,8)
   132  f0     	      	= 1		 ! [MPa] valor de referência (23,7,8)  
   133  thetavp       	= 1		 ! 0 - totalmente explícito, 1 - semi-implicito (7,8)  
   134  !   
   135  !********************************************************************!  
   136  !****_ 		2.3 Parâmetros constitutivos do revest	_****! 
   137  !********************************************************************!  
   138  ! Tipo de material  
   139  !	0 - Sem revestimento  
   140  !	1 - Ansys_Elástico   
   141  !	2 - Usermat_Viscoelastico_CEB-MC90
   142  !   
   143  matrev 		= 0		! Tipo de material (0-SR,1-E,2-VE)
   144  !   
   145  ! Parâmetros para os modelos 1 e 2 
   146  E2 		= 30000		! [MPa] módulo de elasticidade do revestimento (matrev=1)
   147  nu2 		= 0.2    	! [adm] coeficiente de Poisson do revestimento (matrev=1,2)		   
   148  !   
   149  ! Parâmetros para o modelo 2   
   150  fck 		= 20		! [MPa] resistência característica do concreto (2)
   151  s 		= 0.2		! [adm] coef. que depende do tipo de concreto (2)
   152  ti 		= 0		! [dias] início do concreto (2)  
   153  rh 		= 70		! [%] umidade relativa do ambiente (2)   
   154  hf 		= (Re**2-(Re-esp)**2)/(Re-esp) ! [m] espessura fictítica (QUEVEDO, 2017, p. 84) (2)   
   155  hf1		= (Re1**2-(Re1-esp1)**2)/(Re1-esp1)  ! [m] espessura fictítica da galeria (QUEVEDO, 2017, p. 84) (2)  
   156  ts 		= 7		! [dias] idade do concreto no início da secagem (2)  
   157  t0		= 1		! [dias] idade do concreto no início do carregamento (2)  
   158  tinf		= 3000		! [dias] tempo final da análise (2)  
   159  betasc 		= 8d0		! [adm] coeficiente que depende do tipo de cimento (2)  
   160  temperatura 	= 20		! [oC] temperatura (2)   
   161  alpha 		= 1		! [adm] efeito do tipo de cimento durante a cura (2)   
   162  ndec  		= 10		! [década] No. de pontos por decada na discretização (2)   
   163  ligafluencia 	= 1		! [un] 1 - liga fluência, 0 - desliga fluência (2) 
   164  ligaretracao 	= 1		! [un] 1 - liga retração, 0 - desliga retração (2)   
   165  ktime		= 10		! [dias] tempo da análise para saída de dados
   166  kelemid		= 2060		! [un] identificação do elemento para saída 
   167  kkDomIntPt	= 1		! [un] identificação do ponto de integração para saída 
   168  !   
   169  ! Calculo do módulo
   170  fcm 		= fck + 8 
   171  E2 		= 21500*(fcm/10)**(1/3)		    					 
   172  !************************************************************!  
   173  !****_ 		2.4 Condições de Contorno	  	_****!  
   174  !************************************************************!  
   175  prx 		= 40 		! [MPa] tensões iniciais na direção x   
   176  pry		= 30		! [MPa] tensões iniciais na direção y 
   177  prz		= (prx+pry)/2	! nu1*(prx+pry)	! [MPa] tensões iniciais na direção z 
   178  !   
   179  !************************************************************!  
   180  !****_ 		2.5 Discretização do tempo nos passos	_****! 
   181  !************************************************************!  
   182  !   
   183  ! Discretização do tempo durante os passos de escavação tunel longitudinal  
   184  tp 		= Lp/(Vp) 	! [dias] tempo para fazer um passo de escavação nos tuneis longitudinais  
   185  dtp 		= 0.5*tp	! [dias] incremento de tempo inicial dentro de cada passo
   186  dtpmax 		= dtp 		! [dias] incremento máximo de tempo dentro de cada passo  
   187  !   
   188  ! Discretização do tempo durante os passos de escavação da galeria  
   189  tp1 		= Lp1/(Vp1) 	! [dias] tempo para fazer um passo de escavação na galeria transversal 
   190  dtp1		= 0.5*tp1	! [dias] incremento de tempo inicial dentro de cada passo   
   191  dtpmax1		= dtp1		! [dias] incremento máximo de tempo dentro de cada passo  
   192  !   
   193  ! Discretização do tempo nos passos após a escavação   
   194  tp2 		= 100 		! [dias] tempo de cada passo de solução após a escavação do túnel   
   195  np2max 		= 30 		! [un] número máximo de passos de solução após a escavação do túnel 
   196  dtp2		= 0.5*tp2	! [dias] incremento de tempo de cada passo  
   197  !   
   198  tp2autots	= 1		! Especifica quando usar incremento de tempo automático 
   199  !				!      -1 - O programa escolhe 
   200  !				! 	0 - não usa incremento de tempo automático (usa apenas dtp2)  
   201  !				!	1 - usa incremento de tempo automático (usa o dpt2min e dpt2max)
   202  tp2carry	= 1		! Incremento de tempo entre passos
   203  !				!	0 - usa o dtp2 como o incremento de tempo em cada passo  
   204  !				!	1 - usa o incremento de tempo do passo anterior em cada passo (se dtp2autots = 1)
   205  dtp2min		= tp2/2		! [dias] incremento mínimo de tempo de cada passo
   206  dtp2max		= tp2		! [dias] incremento máximo de tempo de cada passo				! 
   207  !   
   208  deltaumin	= 1E-8		! [adm] critério de convergência no tempo   
   209  !   
   210  !************************************************************!  
   211  !****_ 		2.6 Discretização da malha              _****!   
   212  !************************************************************!  
   213  tipoelem 	= 1 		! elementos fora da região da galeria: 1 - SOLID185, 2 - SOLID186  
   214  formaint	= 0		! integração 0 - completa, 1 - reduzida 
   215  tipoelem1 	= 2 		! elementos na região da galeria: 1 - SOLID185, 2 - SOLID186  
   216  formaint1	= 0		! integração 0 - completa, 1 - reduzida
   217  !   
   218  nLp		= 1		! [un] numero de elementos no passo escavado do túnel longitudinal   
   219  nLp1		= 2 		! [un] numero de elementos no passo escavado da galeria 
   220  nL1 		= 15 		! [un] numero de elementos ao longo do eixo do tunel longitudinal no trecho não escavado  
   221  mL1 		= 1/5 		! [adm] taxa de crescimento   
   222  nesp 		= 2 		! [un] numero de elementos na espessura do revestimento do tunel longitudinal  
   223  nCRe 		= 18 		! [un] numero de elementos na interface entre maciço e o revestimento do tunel longitudinal (deve ser par)   
   224  nRi 		= nCRe/2 	! [un] numero de elementos na horizontal e vertical do maciço escavado no tunel longitudinal   
   225  mRi 		= 0 		! [adm] taxa de crecimento  
   226  nd3 		= nCRe/2 	! [un] numero de elementos na horizontal e vertical oposta ao tunel longitudinal
   227  m4ga		= Lp1/1.5 	! [m] tamanho dos elementos na galeria 
   228  !   
   229  *IF,d1,EQ,3,THEN
   230  	nd1 		= 5		! [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal  
   231  	md1 		= 5 		! [adm] taxa de crescimento		  
   232  	nd4 		= 15 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal 
   233  	md4 		= 8 		! [adm] taxa de crescimento
   234  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   235  	md6		= md1		! [adm] taxa de crescimento
   236  	nd5		= 6		! [un] numero de elementos no trecho adjacente a galeria transversal 
   237  	md5		= 4		! [adm] taxa de crescimento  
   238  *ELSEIF,d1,EQ,4,THEN
   239  	nd1 		= 7		! [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal  
   240  	md1 		= 5 		! [adm] taxa de crescimento		  
   241  	nd4 		= 12 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal 
   242  	md4 		= 6 		! [adm] taxa de crescimento
   243  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   244  	md6		= md1		! [adm] taxa de crescimento
   245  	nd5		= 6		! [un] numero de elementos no trecho adjacente a galeria transversal 
   246  	md5		= 4		! [adm] taxa de crescimento  
   247  *ELSEIF,d1,EQ,5,THEN
   248  	nd1 		= 20		! [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal 
   249  	md1 		= 2 		! [adm] taxa de crescimento		  
   250  	nd4 		= 16 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal 
   251  	md4 		= 10 		! [adm] taxa de crescimento   
   252  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   253  	md6		= md1		! [adm] taxa de crescimento
   254  	nd5		= 6		! [un] numero de elementos no trecho adjacente a galeria transversal 
   255  	md5		= 4		! [adm] taxa de crescimento  
   256  *ELSEIF,d1,EQ,6,THEN
   257  	nd1 		= 9		! [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal  
   258  	md1 		= 7 		! [adm] taxa de crescimento		  
   259  	nd4 		= 12 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal 
   260  	md4 		= 6 		! [adm] taxa de crescimento
   261  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   262  	md6		= md1		! [adm] taxa de crescimento
   263  	nd5		= 6		! [un] numero de elementos no trecho adjacente a galeria transversal 
   264  	md5		= 4		! [adm] taxa de crescimento  
   265  *ELSEIF,d1,EQ,8,THEN
   266  	nd1 		= 14		! [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal 
   267  	md1 		= 10 		! [adm] taxa de crescimento		 
   268  	nd4 		= 12 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal 
   269  	md4 		= 6 		! [adm] taxa de crescimento
   270  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   271  	md6		= md1		! [adm] taxa de crescimento
   272  	nd5		= 8		! [un] numero de elementos no trecho adjacente a galeria transversal 
   273  	md5		= 6		! [adm] taxa de crescimento  
   274  *ELSEIF,d1,EQ,10,THEN   
   275  	nd1 		= 14		! [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal 
   276  	md1 		= 10 		! [adm] taxa de crescimento		 
   277  	nd4 		= 12 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal 
   278  	md4 		= 6 		! [adm] taxa de crescimento
   279  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   280  	md6		= md1		! [adm] taxa de crescimento
   281  	nd5		= 8		! [un] numero de elementos no trecho adjacente a galeria transversal 
   282  	md5		= 6		! [adm] taxa de crescimento	 
   283  *ELSEIF,d1,EQ,16,THEN   
   284  	nd1 		= 18		! 16 [un] numero de elementos na horizontal e vertical contigua ao tunel longitudinal (exemplo: 6, 8, 12)  
   285  	md1 		= 20 		! 16 [adm] taxa de crescimento (exmeplo: 5, 8, 10)		  
   286  	nd4 		= 5 		! [un] numero de elementos na horizontal e vertical contigua a região próxima do tunel longitudinal  
   287  	md4 		= 1.5 		! [adm] taxa de crescimento  
   288  	nd6		= nd1*2		! [un] número de elementos na vertical contígua a galeria transversal  
   289  	md6		= md1		! [adm] taxa de crescimento
   290  	nd5		= 12		! 8 [un] numero de elementos no trecho adjacente a galeria transversal (exemplo: 6, 8)  
   291  	md5		= 4		! 3 [adm] taxa de crescimento (exemplo: 2, 6)
   292  *ENDIF	 
   293  !   
   294  !************************************************************!  
   295  !****_ 		2.7 Configuração da saida de dados    	_****!
   296  !************************************************************!  
   297  teta		= 90		! angulo da posição do perfil de convergências no túnel longitudinal
   298  direcao 	= 'Y'		! componente dos deslocamentos para o perfil de convergências										    						  
   299  iso		= 0 		! 0 - contorno padrão, 1 - isolinhas (apenas 0 se isosup=1) 
   300  flag1 		= 1 		! 1 - saida jpg do gráfico de convergência em arquivo   
   301  flag2 		= 1 		! 1 - saida txt de resultados do gráfico de convergênci 
   302  flag3 		= 1 		! 1 - saida do gráfico de convergência na tela do Ansys 
   303  !   
   304  ! Obs: os arquivos de imagem jpg saem com o nome jobname###.jpg 
   305  ! onde ### é um inteiro que vai incrementando a partir da última  
   306  ! numeração do último arquivo plotado.   
   307  ! Os campos de resultados serão referentes ao final da análise.   
   308  !   
   309  !***********************************************************!   
   310  !****_ 		2.8 Configurações da solução	     	_****!  
   311  !***********************************************************!   
   312  !   
   313  nr	= 2	! Tipo de Newton-Raphson 
   314  !		! 1 - INIT rigidez não é atualizada
   315  !		! 2 - FULL rigidez atualizada a cada iteração  
   316  !		! 3 - UNSYM assimétrica atualizada a cada iteração
   317  !   
   318  ! Tolerâncias durante os passos de escavação do túnel longitudinal  
   319  tolf	= 1e-6	! tolerância para o resíduo (padrão 0.005)   
   320  tolu	= 1e-4	! tolerância para o incremento de deslocamento (padrão 0.05)  
   321  !   
   322  ! Tolerâncias durante os passos de escavação da galeria transversal  
   323  tolf1	= 1e-6	! tolerância para o resíduo  
   324  tolu1	= 1e-4	! tolerância para o incremento de deslocamento
   325  !   
   326  ! Tolerâncias durante os passos após a construção do túnel 
   327  tolf2	= 1e-6	! tolerância para o resíduo  
   328  tolu2	= 1e-4	! tolerância para o incremento de deslocamento
   329  !   
   330  ! Tolerância para o incremento de deformação plástica equivalente   
   331  plslimit = 0.99 
   332  !   
   333  psc	= 1	! 1 - Ativa, 0 - desativa a opção de paralelização SMP  
   334  nlg	= 0	! 1 - Ativa, 0 - desativa a não lineariedade geométrica   
   335  soleq	= 1	! 1 - calcula o equilibrio do maciço antes de iniciar
   336  !   
   337  !   
   338  !************************************************************!  
   339  !****_ 		2.9 Titulo e nome dos arquivos  	_****!
   340  !************************************************************!  
   341  ! defini titulo na tela do Ansys
   342  /TITLE, Re=%Re% matmacico=%matmacico% E1=%E1% pr=%pr% matrev=%matrev% E2=%E2% vp=%vp%   
   343  !   
   344  ! define nome file.* para os arquivos da analise
   345  /FILNAME,file,0 
   346  !   
   347  !   
   348  !   
   349  !   
   350  !------------------FIM ENTRADA DE DADOS---------------------!   
   351  !   
   352  !   
   353  !   
   354  !   
   355  !************************************************************!  
   356  !****_ 3. PRÉ-PROCESSAMENTO 				_****! 
   357  !************************************************************!  
   358  /PREP7 ! inicia módulo de pré-processamento   
   359  !   
   360  !************************************************************!  
   361  !****_ 		3.1 Calculos iniciais			_****! 
   362  !************************************************************!  
   363  ri 		= re-esp		! [m] raio da face interna do revestimento dos tuneis longitudinais  
   364  l1		= l1*Re    		! [m] comprimento do trecho não escavado  
   365  l2		= l2*Lp			! [m] comprimento do trecho escavado  
   366  lt 		= l1+l2 		! [m] comprimento total do modelo ao longo do eixo longitudinal  
   367  d1 		= d1*Re			! [m] distância entre eixos dos túneis longitudinais (d1 = 16*Re ou d1 = 4*Re) 
   368  d4 		= d4*re 		! [m] distância das bordas laterais do domínio até o eixo do tunel longitudinal   
   369  l3 		= (d1/2+d4)*2 		! [m] dimensão transversal do modelo  
   370  d3		= d3*Re			! [m] altura do domínio (profundidade do eixo do túnel longitudinal)
   371  d5		= d5*Lp			! [m] distância adjacente a galeria com malha livre (exemplo: 1, 2, 4, 6)
   372  np	 	= l2/Lp 		! [un] numero total passos escavados nos tuneis longitudinais
   373  nesc 		= np-npi+1 		! [un] total de escavações ao longo do eixo do tunel longitudinal 
   374  d0		= nd0*lp		! [m] dimensão não suportada (multiplo do passo)
   375  !   
   376  ri1 		= re1-esp1 		! [m] raio da face interna do revestimento das galerias transversais 
   377  d2 		= l2/2 			! [m] posição da galeria ao longo do eixo longitudinal 
   378  d01		= nd01*Lp1		! [m] [m] dimensão não suportada da galeria (multiplo do passo)  
   379  np1 		= (d1/2-re)/Lp1 	! [un] total de passos escavados nas galerias transversais   
   380  nesc1 		= NINT(np1-npi1+1) 		! [un] total de escavações ao longo do eixo das galerias transversais
   381  !pig1 		= pig1+l2/(2*Lp)	! [un] numero de passos de escavação no túnel longitudinal no qual iniciará a escavação da galeria 1 
   382  !   
   383  nescinig		= np/2-npi+1+re1/Lp+pig1	! [un] numero da escavação em que se inicia a galeria  
   384  !   
   385  m1		= Lp/nLp 		! [m] tamanho do elemento ao longo do eixo do tunel longitudinal no trecho escavado  
   386  m9 		= m1 			! [m] tamanho dos elementos na região do tunel oposta a galeria   
   387  !   
   388  vpi = 3.14159265358979323846
   389  !   
   390  ! caso não haja escavação na galeria 
   391  *IF,escavagaleria,EQ,0,THEN 
   392  	nesc1 = 0  
   393  *ENDIF  
   394  !   
   395  ! verificando se haverá análise após a construção do túnel
   396  analise2 = 0
   397  *IF,matmacico,GT,6,OR,matrev,GT,1,THEN  
   398  	analise2 = 1   
   399  *ENDIF  
   400  *IF,matmacico,EQ,23,THEN
   401  	analise2 = 1   
   402  *ENDIF  
   403  !   
   404  !************************************************************!  
   405  !****_ 		3.2 Elementos finitos 			_****!
   406  !************************************************************!  
   407  *IF,tipoelem,EQ,1,THEN  
   408  	ET,1,SOLID185  
   409  	KEYOPT,1,2,formaint
   410  	KEYOPT,1,3,0   
   411  	KEYOPT,1,6,0   
   412  	KEYOPT,1,8,0   
   413  *ELSEIF,tipoelem,EQ,2,THEN  
   414  	ET,1,SOLID186  
   415  	KEYOPT,1,2,formaint
   416  	KEYOPT,1,3,0   
   417  	KEYOPT,1,6,0   
   418  	KEYOPT,1,8,0   
   419  *ENDIF  
   420  !   
   421  *IF,tipoelem1,EQ,1,THEN 
   422  	ET,2,SOLID185  
   423  	KEYOPT,2,2,formaint1   
   424  	KEYOPT,2,3,0   
   425  	KEYOPT,2,6,0   
   426  	KEYOPT,2,8,0   
   427  *ELSEIF,tipoelem1,EQ,2,THEN 
   428  	ET,2,SOLID186  
   429  	KEYOPT,2,2,formaint1   
   430  	KEYOPT,2,3,0   
   431  	KEYOPT,2,6,0   
   432  	KEYOPT,2,8,0   
   433  *ENDIF  
   434  !   
   435  !************************************************************!  
   436  !****_ 		3.3 Material do maciço 			_****!  
   437  !************************************************************!  
   438  *IF,matmacico,eq,1,then 
   439  	! Definindo o material elastico do Ansys   
   440  	MPTEMP,1,0  		 
   441  	MPDATA,EX,1,,E1	   
   442  	MPDATA,PRXY,1,,nu1 	   
   443  *ELSEIF,matmacico,eq,2,then 
   444  	! Definindo o material elastoplástico VM do Ansys bilienar
   445  	yield	    	= 2*c1			! [MPa]	tensão de escoamento  
   446  	Ep 		= 2*(c2-c1)/(eps1)	! [MPa] módulo plástico tangente 
   447  	youngt      	= Ep*E1/(E1+Ep)		! [MPa] módulo de elastoplástico tangente  
   448  	!  
   449  	MPTEMP,1,0  		 
   450  	MPDATA,EX,1,,E1	   
   451  	MPDATA,PRXY,1,,nu1 	   
   452  	TB,BISO,1,1,2, 
   453  	TBTEMP,0   
   454  	TBDATA,,yield,youngt,,,,   
   455  *ELSEIF,matmacico,eq,22,then
   456  	! Definindo o material elastoplástico VM do Ansys multilinear 
   457  	yield	    	= 2*c1			! [MPa]	tensão de escoamento  
   458  	Ep 		= 2*(c2-c1)/(eps1)	! [MPa] módulo plástico tangente 
   459  	youngt      	= Ep*E1/(E1+Ep)		! [MPa] módulo de elastoplástico tangente  
   460  	epst0		= 2*c1/E1		! [adm] deformação total no escoamento 
   461  	epst1		= 2*c2/E1 + eps1 	! [adm] deformação total na zona 1  
   462  	epst2		= 2*c2/E1 + eps2	! [adm] deformação total na zona 2	  
   463  	epst3		= 2*c3/E1 + eps3	! [adm] deformação total na zona 3   
   464  	!  
   465  	MPTEMP,1,0  		 
   466  	MPDATA,EX,1,,E1	   
   467  	MPDATA,PRXY,1,,nu1 	   
   468  	TB,MISO,1,1,5,0
   469  	TBTEMP,0   
   470  	TBPT,,epst0,2*c1   
   471  	TBPT,,epst1,2*c2   
   472  	TBPT,,epst2,2*c2   
   473  	TBPT,,epst3,2*c3   
   474  	TBPT,,0.1,2*c3 
   475  *ELSEIF,matmacico,eq,23,then
   476  	! Definindo o material viscoplastico perzyna VM do Ansys   
   477  	yieldvp	    	= 2*cvp				! [MPa]	tensão de escoamento  
   478  	youngtvp      	= 0				! [MPa] módulo de elastoplástico tangente  
   479  	gamma	      	= ((yieldvp/f0)**n1)/eta 	! [dias^-1] coeficiente Gamma do modelo de Perzyna Ansys
   480  	m  	      	= 1/n1				! [adm] coeficiente m do modelo de Perzyna do ANSYS   
   481  	!  
   482  	MPTEMP,1,0  		 
   483  	MPDATA,EX,1,,E1	   
   484  	MPDATA,PRXY,1,,nu1	
   485  	TB,BISO,1,1,2, 
   486  	TBTEMP,0   
   487  	TBDATA,,yieldvp,youngtvp,,,,   
   488  	TB,RATE,1,1,2,1
   489  	TBTEMP,0   
   490  	TBDATA,,m,gamma,,,,	   
   491  *ELSEIF,matmacico,eq,4,then 
   492  	! Definindo material usermat3D VM do Ansys 
   493  	yield	    	= 2*c1			! [MPa]	tensão de escoamento  
   494  	Ep 		= 2*(c2-c1)/(eps1)	! [MPa] módulo plástico tangente 
   495  	youngt      	= Ep*E1/(E1+Ep)		! [MPa] módulo de elastoplástico tangente  
   496  	!  
   497  	TB,USER,1,2,5  
   498  	TBTEMP,1.0 		  
   499  	TBDATA,1,matmacico,E1,nu1,yield,youngt ! modelo, E, posn, sigy, H  
   500  	TB,STATE,1,,8  
   501  *ELSEIF,matmacico,eq,5,then 
   502  	! Definindo material usermat3D_elastico
   503  	TB,USER,1,2,3  
   504  	TBTEMP,1.0 		  
   505  	TBDATA,1,matmacico,E1,nu1  
   506  	TB,STATE,1,,8	 
   507  *ELSEIF,matmacico,eq,6,then 
   508  	! Definindo material usermat3D_EP  
   509  	TB,USER,1,2,14 
   510  	TBTEMP,1.0 		  
   511  	TBDATA,1,matmacico,E1,nu1  
   512  	TBDATA,4,superficief,superficieg   
   513  	TBDATA,6,fi,psi,   
   514  	TBDATA,8,c1,c2,c3,eps1,eps2,eps3   
   515  	TBDATA,14,Dalg 
   516  	TB,STATE,1,,20	
   517  *ELSEIF,matmacico,eq,7,then 
   518  	! Definindo material usermat3D_VP  
   519  	TB,USER,1,2,13 
   520  	TBTEMP,1.0 		  
   521  	TBDATA,1,matmacico,E1,nu1  
   522  	TBDATA,4,superficiefvp,superficiegvp   
   523  	TBDATA,6,fivp,psivp,   
   524  	TBDATA,8,cvp,n1,eta,f0,thetavp	
   525  	TB,STATE,1,,20		   
   526  *ELSEIF,matmacico,eq,8,then 
   527  	! Definindo material usermat3D_EPVP
   528  	TB,USER,1,2,23 
   529  	TBTEMP,1.0 		  
   530  	TBDATA,1,matmacico,E1,nu1  
   531  	TBDATA,4,superficief,superficieg   
   532  	TBDATA,6,fi,psi,   
   533  	TBDATA,8,c1,c2,c3,eps1,eps2,eps3   
   534  	TBDATA,14,Dalg 
   535  	TBDATA,15,superficiefvp,superficiegvp  
   536  	TBDATA,17,fivp,psivp   
   537  	TBDATA,19,cvp  
   538  	TBDATA,20,n1,eta,f0
   539  	TBDATA,23,thetavp	 
   540  	TB,STATE,1,,20 
   541  *ENDIF  
   542  !   
   543  !************************************************************!  
   544  !****_ 		3.4 Material do revestimento		_****!   
   545  !************************************************************!  
   546  *IF,matrev,EQ,1,THEN
   547  	*DO,i,2,nesc+nesc1,1   
   548  		MPTEMP,1,0  				  
   549  		MPDATA,EX,i,,E2				   
   550  		MPDATA,PRXY,i,,nu2
   551  	*ENDDO 			 
   552  *ELSEIF,matrev,EQ,2,THEN
   553  	*DO,i,2,nesc+nesc1,1   
   554  		TB,USER,i,1,18
   555  		TBTEMP,1.0
   556  		TBDATA,1,9
   557  		TBDATA,2,ligafluencia,ligaretracao
   558  		! 
   559  		*IF,escavagaleria,EQ,1,THEN   
   560  			*IF,i,LT,nesc+nesc1,THEN 
   561  				TBDATA,4,npi*tp+tp*(i-2)
   562  				TBDATA,10,s,rh,hf,betasc,alpha  
   563  			*ELSE
   564  				TBDATA,4,tp*nesc + tp1*np1 + tp1*(i-2)  
   565  				TBDATA,10,s,rh,hf1,betasc,alpha 
   566  			*ENDIF   
   567  		*ELSE 
   568  			TBDATA,4,npi*tp+tp*(i-2) 
   569  			TBDATA,10,s,rh,hf,betasc,alpha   
   570  		*ENDIF
   571  		! 
   572  		TBDATA,5,ts,t0,tinf   
   573  		TBDATA,8,fck,nu2  
   574  		TBDATA,15,ndec
   575  		TBDATA,16,ktime,kelemid,kkDomIntPt
   576  		TB,STATE,i,,500   
   577  	*ENDDO	
   578  *ENDIF  
   579  !   
   580  !************************************************************!  
   581  !****_ 		3.5 Modelando o sólido			_****!   
   582  !************************************************************!  
   583  !   
   584  ! Definindo a vista 
   585  /VIEW,1,1,1,1   
   586  /ANG,1  
   587  !   
   588  ! criando bloco e casca cilindrica do trecho não escavado  
   589  BLC4,-d4,0,l3/2,d3,l1   
   590  CYL4,0,0,ri,0,re,180,l1 
   591  !   
   592  ! criando bloco e casca cilindrica do trecho que será escavado 
   593  WPOFFS,0,0,l1   
   594  BLC4,-d4,0,l3/2,d3,l2   
   595  CYL4,0,0,ri,0,re,180,l2 
   596  !   
   597  ! excluindo volumes em comum
   598  VPTN,ALL
   599  !   
   600  ! tolerancia para operações booleanas 
   601  BTOL,1E-4   
   602  !   
   603  ! dividindo os volumes no plano vertical do eixo do tunel principal 
   604  WPOFFS,0,0,0
   605  WPRO,,,90.000000
   606  VSBW,ALL
   607  !   
   608  ! dividindo o volume entre tuneis na altura 
   609  VSEL,ALL
   610  VSEL,S,LOC,X,0,d1/2 
   611  WPOFFS,0,d1/2,0 
   612  WPRO,,90,   
   613  VSBW,ALL
   614  !   
   615  ! criando o mesmo volume no lado oposto do plano vertical do eixo do tunel  
   616  VSEL,ALL
   617  VSEL,S,LOC,X,0,d1/2 
   618  VSEL,R,LOC,Y,0,d1/2 
   619  CSYS,1  
   620  VSEL,U,LOC,X,0,re   
   621  CSYS,0  
   622  VSYMM,X,ALL, , ,0,1,0   
   623  !   
   624  ! criando primeiro tunel transversal
   625  WPAVE,0,0,0 
   626  WPCSYS,-1,0 
   627  WPOFFS,0,0,lt-d2/2		
   628  WPRO,,,90   
   629  CYL4,0,0,ri1,0,re1,180,d1/2 
   630  !   
   631  ! criando plano de corte da galeria transversal 
   632  CSYS,1  
   633  VSEL,ALL
   634  VSEL,S,LOC,Z,l1,lt  
   635  VSEL,R,LOC,X,ri/2,re
   636  ASEL,S,EXT  
   637  CSYS,1  
   638  ASEL,R,LOC,X,re,re  
   639  ASEL,R,LOC,Z,l1+l2/2,l1+l2/2
   640  CM,A0,AREA  
   641  !   
   642  ! cortando a galeria transversal
   643  CSYS,0  
   644  ALLSEL,ALL  
   645  VSEL,S,LOC,Z,lt-d2/2+re1,lt-d2/2-re1
   646  VSBA,ALL,A0 
   647  !   
   648  ! deletando trecho da galeria transversal dentro do tunel longitudinal  
   649  ALLSEL,ALL  
   650  WPAVE,0,0,0 
   651  WPCSYS,-1,0 
   652  VSEL,S,LOC,Z,lt-d2/2,lt-d2/2
   653  VSEL,R,LOC,X,0,re   
   654  VSEL,R,LOC,Y,0,re1  
   655  VDELE,ALL,,,1   
   656  !   
   657  ! Alterando posição da galeria para a metade de L2
   658  ALLSEL,ALL  
   659  WPAVE,0,0,0 
   660  WPCSYS,-1,0 
   661  VSEL,S,LOC,Z,lt-d2/2,lt-d2/2
   662  VSEL,R,LOC,X,re,d1/2
   663  VSEL,R,LOC,Y,0,re1  
   664  VGEN, ,ALL, , , , ,-d2/2, , ,1  
   665  !   
   666  ! cortando trecho do tunel principal
   667  VSEL,ALL
   668  WPAVE,0,0,0 
   669  WPCSYS,-1,0 
   670  WPOFFS,0,0,(lt-l2/2)+re1+d5		   
   671  VSBW,ALL
   672  WPOFFS,0,0,-2*re1-2*d5  
   673  VSBW,ALL
   674  !   
   675  ! particionando outros volumes  
   676  VSEL,ALL
   677  VPTN,ALL
   678  !   
   679  ! Cortando no meio da galeria   
   680  VSEL,ALL
   681  WPAVE,0,0,0 
   682  WPCSYS,-1,0 
   683  VSEL,S,LOC,Z,lt-l2/2-d5,lt-l2/2+d5  
   684  WPOFFS,0,0,lt-l2/2  
   685  VSBW,ALL
   686  !   
   687  ! Deletando os volumes na metade da galeria 
   688  VSEL,ALL
   689  WPAVE,0,0,0 
   690  WPCSYS,-1,0 
   691  VSEL,S,LOC,Z,l1+l2/2,l1+l2/2-re1-d5 
   692  VSEL,R,LOC,X,-d1/2,d1/2 
   693  VSEL,R,LOC,Y,0,d1/2 
   694  VDELE,ALL,,,1   
   695  !   
   696  ! juntando pontos duplicados
   697  ALLSEL,ALL  
   698  NUMMRG,KP, , , ,LOW 
   699  !   
   700  ! renumerando a geometria   
   701  NUMCMP,KP   
   702  NUMCMP,LINE 
   703  NUMCMP,AREA 
   704  NUMCMP,VOLU 
   705  !   
   706  !************************************************************!  
   707  !****_ 		3.6 Divisões para a malha nas linhas 	_****!  
   708  !************************************************************!  
   709  !   
   710  ! tamanho do elemento ao longo do eixo do tunel longitudinal no trecho escavado (parte a frente da galeria) 
   711  CSYS,0  
   712  LSEL,ALL
   713  LSEL,S,LOC,Z,lt-0.01,lt-l2/2+re1+d5+0.01
   714  LSEL,R,LOC,X,-d4,d1/2   
   715  LSEL,R,LOC,Y,0,d3   
   716  LESIZE,ALL,m1, , , , , , ,1 
