  3372  !   
  3373  ! Escrevendo em arquivo as convergências   
  3374  *CREATE,ansuitmp
  3375  *MWRITE,convergencex,convergencex_zf_%teta%,txt 
  3376  (1000(E10.4,3X))
  3377  *END
  3378  /INPUT,ansuitmp 
  3379  !   
  3380  *CREATE,ansuitmp
  3381  *MWRITE,convergencey,convergencey_zf_%teta%,txt 
  3382  (1000(E10.4,3X))
