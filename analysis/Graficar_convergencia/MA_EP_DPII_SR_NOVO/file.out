  2196  *IF,soleq,EQ,1,THEN 
  2197  	ANTYPE,0,NEW   
  2198  	ESEL,ALL   
  2199  	TIME,1 
  2200  	DELTIM,1,,1
  2201  	!CNVTOL,F,,tolf,,0.01  
  2202  	!CNVTOL,U,,tolu
  2203  	SOLVE  
  2204  	FINISH 
  2205  	!  
  2206  	! Plota a solução
  2207  	/POST1 
  2208  	RSYS,0 
  2209  	ESEL,S,LIVE
  2210  	PLNSOL, U,SUM, 0,1.0   
  2211  	ESEL,ALL   
  2212  *ENDIF  
  2213  !   
  2214  ! numero máximo de analises
  2215  nanalises = 0   
  2216  nanalises=nesc+nesc1
  2217  *IF,analise2,EQ,1,THEN  
  2218  	nanalises=nanalises + np2max   
  2219  *ENDIF	 
  2220  !   
  2221  ! criando a tabela com o criterio de parada do longo prazo (np2,deltau,uatual)  
  2222  *IF,analise2,EQ,1,THEN  
  2223  	*DIM,criterio,TABLE,nanalises,3
  2224  *ENDIF  
  2225  !   
  2226  ! Selecionando o nó de controle da convergencia no tempo		 
  2227  uatual = 0  
  2228  LOCAL,11,1,0,0,lt,0,0,0,0   
  2229  CSYS,11,
  2230  ALLSEL,ALL  
  2231  NSEL,S,LOC,X,Re-0.01,Re+0.01
  2232  NSEL,R,LOC,Y,teta-0.01,teta+0.01
  2233  NSEL,R,LOC,Z,0  
  2234  NSLE,R,CORNER   
  2235  CSYS,0  
  2236  *GET,nocontrole,NODE,0,NUM,MAX  
  2237  ALLSEL,ALL  
  2238  !   
  2239  ! Solução com as escavações 
  2240  /SOL
  2241  *IF,matmacico,LE,1,AND,matrev,EQ,0,THEN 
  2242  	!  
  2243  	! Maciço elástico sem revestimento (não precisa rodar a cada escavação)   
  2244  	ANTYPE,0,NEW   
  2245  	!  
  2246  	! primeira escavação 
  2247  	i=1
  2248  	CMSEL,S,LESC %i%,ELEM  
  2249  	EKILL,ALL  
  2250  	ESEL,S,LIVE
  2251  	EPLOT  
  2252  	*DO,i,2,nesc,1 
  2253  		! desligando elementos do grupo de escavação i  
  2254  		CMSEL,S,LESC %i%,ELEM 
  2255  		EKILL,ALL 
  2256  		ESEL,S,LIVE   
  2257  		EPLOT 
  2258  		! 
  2259  		! ligando elementos do grupo de revestimento i-1  
  2260  		*IF,matrev,NE,0,THEN  
  2261  			CMSEL,S,Lrev %i-1%,ELEM  
  2262  			EALIVE,ALL   
  2263  			*IF,revested0,EQ,1,THEN  
  2264  				*IF,i,EQ,nesc,THEN  
  2265  					CMSEL,S,Lrev %i%,ELEM  
  2266  					EALIVE,ALL 
  2267  				*ENDIF  
  2268  			*ENDIF   
  2269  			*IF,revesteface,EQ,1,THEN
  2270  				*IF,i,EQ,nesc,THEN  
  2271  					CMSEL,S,Lrevface,ELEM  
  2272  					EALIVE,ALL 
  2273  					CMSEL,S,soloface,ELEM  
  2274  					EKILL,ALL  
  2275  				*ENDIF  
  2276  			*ENDIF   
  2277  		*ENDIF
  2278  		ESEL,S,LIVE   
  2279  		EPLOT 
  2280  		! 
  2281  		! grupo de escavação da galeria 1   
  2282  		*IF,escavagaleria,EQ,1,THEN   
  2283  			*IF,i,EQ,nescinig,THEN   
  2284  				! escava entrada da galeria 1   
  2285  				*IF,matrev,NE,0,THEN
  2286  					ESEL,ALL   
  2287  					CMSEL,S,T1escent,ELEM  
  2288  					EKILL,ALL  
  2289  					ESEL,S,LIVE
  2290  					EPLOT  
  2291  				*ENDIF  
  2292  				!   
  2293  				*DO,j,1,nesc1,1 
  2294  					! desligando os elementos do grupo de escavação  
  2295  					ESEL,ALL   
  2296  					CMSEL,S,T1ESC %j%,ELEM 
  2297  					EKILL,ALL  
  2298  					ESEL,S,LIVE
  2299  					EPLOT  
  2300  					!  
  2301  					! ligando os elementos do grupo de revestimento
  2302  					*IF,matrev,NE,0,THEN   
  2303  						*IF,revestegaleria,EQ,1,THEN  
  2304  							*IF,j,GE,2,THEN  
  2305  								CMSEL,S,T1REV %j-1%,ELEM
  2306  								EALIVE,ALL  
  2307  							*ENDIF   
  2308  						*ENDIF
  2309  					*ENDIF 
  2310  					!  
  2311  					! plotando apenas os elementos ativos  
  2312  					ESEL,S,LIVE
  2313  					EPLOT  
  2314  				*ENDDO  
  2315  			*ENDIF   
  2316  			!
  2317  		*ENDIF
  2318  	*ENDDO 
  2319  	ESEL,ALL   
  2320  	SAVE   
  2321  	!CNVTOL,F,,tolf,,0.01  
  2322  	!CNVTOL,U,,tolu
  2323  	SOLVE  
  2324  	FINISH 
  2325  *ELSE   
  2326  	!  
  2327  	! Necessário fazer vários passos de escavação  
  2328  	ANTYPE,0,NEW   
  2329  	!  
  2330  	! Primeiro passo de escavação
  2331  	i=1
  2332  	CMSEL,S,LESC %i%,ELEM  
  2333  	EKILL,ALL  
  2334  	ESEL,S,LIVE
  2335  	EPLOT  
  2336  	TIME,tp*npi
  2337  	DELTIM,dtp,,dtpmax 
  2338  	ESEL,ALL   
  2339  	!CNVTOL,F,,tolf,,0.01  
  2340  	!CNVTOL,U,,tolu
  2341  	SOLVE  
  2342  	SAVE   
  2343  	FINISH 
  2344  	!  
  2345  	! Mostrar solução da primeira escavação
  2346  	/POST1 
  2347  	RSYS,1 
  2348  	ESEL,S,LIVE
  2349  	PLNSOL, U,SUM, 0,1.0   
  2350  	!  
  2351  	! Próximos passos de escavação  
  2352  	/SOL   
  2353  	ANTYPE,0,RESTART   
  2354  	tad1 = 0   
  2355  	*DO,i,2,nesc,1 
  2356  		! 
  2357  		! desligando elementos do grupo de escavação i  
  2358  		ESEL,ALL  
  2359  		CMSEL,S,LESC %i%,ELEM 
  2360  		EKILL,ALL 
  2361  		ESEL,S,LIVE   
  2362  		EPLOT 
  2363  		! 
  2364  		! ligando elementos do grupo de revestimento i-1  
  2365  		*IF,matrev,NE,0,THEN  
  2366  			CMSEL,S,Lrev %i-1%,ELEM  
  2367  			EALIVE,ALL   
  2368  			*IF,revested0,EQ,1,THEN  
  2369  				*IF,i,EQ,nesc,THEN  
  2370  					CMSEL,S,Lrev %i%,ELEM  
  2371  					EALIVE,ALL 
  2372  				*ENDIF  
  2373  			*ENDIF   
  2374  			*IF,revesteface,EQ,1,THEN
  2375  				*IF,i,EQ,nesc,THEN  
  2376  					CMSEL,S,Lrevface,ELEM  
  2377  					EALIVE,ALL 
  2378  					CMSEL,S,soloface,ELEM  
  2379  					EKILL,ALL  
  2380  				*ENDIF  
  2381  			*ENDIF   
  2382  		*ENDIF
  2383  		! 
  2384  		! grupo de escavação da galeria 1   
  2385  		*IF,escavagaleria,EQ,1,THEN   
  2386  			*IF,i,EQ,nescinig,THEN   
  2387  				! escava entrada da galeria 1   
  2388  				*IF,matrev,NE,0,THEN
  2389  					ESEL,ALL   
  2390  					CMSEL,S,T1escent,ELEM  
  2391  					EKILL,ALL  
  2392  					ESEL,S,LIVE
  2393  					EPLOT  
  2394  				*ENDIF  
  2395  				!   
  2396  				*DO,j,1,nesc1,1 
  2397  					! desligando os elementos do grupo de escavação  
  2398  					ESEL,ALL   
  2399  					CMSEL,S,T1ESC %j%,ELEM 
  2400  					EKILL,ALL  
  2401  					ESEL,S,LIVE
  2402  					EPLOT  
  2403  					!  
  2404  					! ligando os elementos do grupo de revestimento
  2405  					! ligando os elementos do grupo de revestimento
  2406  					*IF,matrev,NE,0,THEN   
  2407  						*IF,revestegaleria,EQ,1,THEN  
  2408  							*IF,j,GE,2,THEN  
  2409  								CMSEL,S,T1REV %j-1%,ELEM
  2410  								EALIVE,ALL  
  2411  							*ENDIF   
  2412  						*ENDIF
  2413  					*ENDIF 
  2414  					!  
  2415  					ESEL,S,LIVE
  2416  					EPLOT  
  2417  					TIME,npi*tp+tp*(i-1)+npi1*tp1+tp1*(j-1)
  2418  					DELTIM,dtp1,,dtpmax1   
  2419  					ESEL,ALL   
  2420  					SAVE   
  2421  					!CNVTOL,F,,tolf1,,0.01 
  2422  					!CNVTOL,U,,tolu1   
  2423  					SOLVE  
  2424  				*ENDDO  
  2425  				tad1 = npi1*tp1+tp1*(nesc1-1)   
  2426  			*ENDIF   
  2427  			!
  2428  		*ENDIF
  2429  		! 
  2430  		! Pular um Loop   
  2431  		*IF,escavagaleria,EQ,1,THEN   
  2432  			*IF,i,EQ,nescinig,THEN   
  2433  				*CYCLE  
  2434  			*ENDIF   
  2435  		*ENDIF
  2436  		! 
  2437  		ESEL,S,LIVE   
  2438  		EPLOT 
  2439  		TIME,npi*tp+tp*(i-1)+tad1 
  2440  		DELTIM,dtp,,dtpmax
  2441  		ESEL,ALL  
  2442  		SAVE  
  2443  		!CNVTOL,F,,tolf,,0.01 
  2444  		!CNVTOL,U,,tolu   
  2445  		SOLVE 
  2446  		! 
  2447  		! Criterio de convergencia no tempo   
  2448  		!criterio(i,1) = tp*(i-1)+tad1
  2449  		uanterior = uatual
  2450  		*GET,uatual,NODE,nocontrole,U,SUM 
  2451  		!deltau = uatual - uanterior  
  2452  		!criterio(i,2) = deltau   
  2453  	*ENDDO 
  2454  	!  
  2455  	np2 = 0
  2456  	*IF,analise2,EQ,1,THEN 
  2457  		! Faz o cálculo após o término da construção do túnel	                    								  
  2458  		*DO,i,1,np2max
  2459  			TIME,npi*tp+tp*(nesc-1)+tad1+i*tp2		 
  2460  			DELTIM,dtp2,dtp2min,dtp2max,tp2carry			  
  2461  			SAVE 
  2462  			!CNVTOL,F,,tolf2,,0.01   
  2463  			!CNVTOL,U,,tolu2			  
  2464  			SOLVE
  2465  			!
  2466  			! Criterio de parada no longo prazo  
  2467  			np2 = np2+1  
  2468  			criterio(np2,1) = npi*tp+tp*(nesc-1)+tad1+i*tp2  
  2469  			uanterior = uatual   
  2470  			*GET,uatual,NODE,nocontrole,U,SUM
  2471  			deltau = abs(uatual - uanterior) 
  2472  			criterio(np2,2) = deltau 
  2473  			criterio(np2,3) = uatual			  
  2474  			!*IF,deltau,LT,deltaumin,*EXIT			
  2475  		*ENDDO
  2476  	*ENDIF	
  2477  	FINISH 
  2478  *ENDIF  
  2479  !   
  2480  !************************************************************!  
  2481  !****_ 5. PÓS-PROCESSAMENTO 				_****! 
  2482  !************************************************************!  
  2483  !   
  2484  !************************************************************!  
  2485  !****_ 		5.1 Configurações iniciais		_****!   
  2486  !************************************************************!  
  2487  !   
  2488  ! mudando a cor da janela   
  2489  /RGB,INDEX,100,100,100,0
  2490  /RGB,INDEX,0,0,0,15 
  2491  !   
  2492  ! qualidade do arquivo jpeg de saida
  2493  JPEG,QUAL,100,  
  2494  JPEG,ORIENT,HORIZ   
  2495  JPEG,COLOR,2
  2496  JPEG,TMOD,1 
  2497  /GFILE,800, 
  2498  /TYPE,,3
  2499  !   
  2500  ! Colocando na angulação  
  2501  /VIEW,1,,-1 
  2502  /ANG,1  
  2503  /ANG,1,30,XS,1  
  2504  /ANG,1,30,XS,1  
  2505  /ANG,1,-30,YS,1 
  2506  /DIST,1,0.729,1 
  2507  /DIST,1,0.729,1 
  2508  /REPLOT 
  2509  !   
  2510  !************************************************************!  
  2511  !****_ 		5.2 Plotando nó de controle no tempo 	_****!  
  2512  !************************************************************!  
  2513  !   
  2514  ! Escrevendo criterio de convergencia no tempo  
  2515  ! criterio(:,1) - tempo 
  2516  ! criterio(:,2) - deltau
  2517  ! criterio(:,3) - uatual
  2518  !   
  2519  *IF,analise2,EQ,1,THEN  
  2520  !   
  2521  *CREATE,ansuitmp
  2522  *MWRITE,criterio,criterio,txt   
  2523  (1000(E10.4,3X))
  2524  *END
  2525  /INPUT,ansuitmp 
  2526  !   
  2527  ! formatando grafico para plotar uatual x tempo 
  2528  /RGB,INDEX,100,100,100,0
  2529  /RGB,INDEX,0,0,0,15 
  2530  /AXLAB,X,t  
  2531  /AXLAB,Y,u(r=Re,z=Lt)   
  2532  /XRANGE,0,npi*tp+tp*(nesc-1)+tad1+np2*tp2   
  2533  *VSCFUN,criteriomax,max,criterio(1,3)   
  2534  /YRANGE,0,criteriomax*1.2   
  2535  /GROPT,DIVY,20  
  2536  /GROPT,DIVX,10  
  2537  /GROPT,DIG1,3   
  2538  /GTHK,CURVE,1   
  2539  /PLOPTS,INFO,on 
  2540  !   
  2541  ! graficando na tela do Ansys   
  2542  /ERASE  
  2543  /SHOW,JPEG,,iso 
  2544  *VLEN,np2   
  2545  *VPLOT,criterio(1,1),criterio(1,3)  
  2546  /SHOW,CLOSE	
  2547  /ERASE  
  2548  !   
  2549  *ENDIF  
  2550  !   
  2551  !************************************************************!  
  2552  !****_ 		5.3 Perfis tunel longitudinal (teta=90) _****! 
  2553  !************************************************************!  
  2554  /POST1  
  2555  !   
  2556  teta		= 90		! angulo da posição do perfil de convergências no túnel longitudinal
  2557  !   
  2558  ! selecionando os nós na interface entre revestimento e o maciço  
  2559  LOCAL,11,1,0,0,lt,0,0,0,0   
  2560  CSYS,11,
  2561  ALLSEL,ALL  
  2562  NSEL,R,LOC,X,Re-0.01,Re+0.01
  2563  NSEL,R,LOC,Y,teta-0.01,teta+0.01
  2564  NSLE,R,CORNER   
  2565  CSYS,0  
  2566  !   
  2567  ! sistemas de referencias dos resultados
  2568  RSYS,1  
  2569  !   
  2570  ! dimensionando arrays  
  2571  nanalises = 0   
  2572  *GET,nanalises,ACTIVE,0,SET,NSET	! pegando o número de análises								   
  2573  *GET,ncount,NODE,,COUNT			  ! pegando numero máximo de nós selecionados   
  2574  *GET,ntotal,NODE,,NUM,MAX		  ! pegando numero total de nós 
  2575      
  2576  *DIM,convergencex,TABLE,ncount,2+nanalises ! dimensionando tabela de convergencias  
  2577  *DIM,convergencey,TABLE,ncount,2+nanalises ! dimensionando tabela de convergencias  
  2578      
  2579  *DIM,stressx,TABLE,ncount,2+nanalises	  ! dimensionando tabela de pressões em x
  2580  *DIM,stressy,TABLE,ncount,2+nanalises	  ! dimensionando tabela de pressões em y
  2581      
  2582  *DIM,coordz,ARRAY,ntotal		  ! dimensionando vetor de coordenadas nodais 
  2583      
  2584  *DIM,ORDER,ARRAY,ncount			  ! array auxiliar para ordenamento   
  2585      
  2586  *DIM,u_x,ARRAY,ntotal			  ! dimensionando vetor de deslocamentos em x   
  2587  *DIM,u_y,ARRAY,ntotal			  ! dimensionando vetor de deslocamentos em y   
  2588      
  2589  *DIM,s_x,ARRAY,ntotal			  ! dimensionando vetor de pressões em x   
  2590  *DIM,s_y,ARRAY,ntotal			  ! dimensionando vetor de pressões em y   
  2591      
  2592  *DIM,n_sel,ARRAY,ntotal			  ! dimensionando vetor que indica se o nó está selecionado 
  2593  !   
  2594  ! coloca lista de nós em ordem na primeira coluna  
  2595  *VGET,convergencex(1,1),NODE,,NLIST 
  2596  *VGET,convergencey(1,1),NODE,,NLIST 
  2597  *VGET,stressx(1,1),NODE,,NLIST  
  2598  *VGET,stressy(1,1),NODE,,NLIST  
  2599  !   
  2600  ! criando vetor de coordenadas  
  2601  *VGET,n_sel(1),NODE,1,NSEL  
  2602  *VGET,coordz(1),NODE,1,LOC,z
  2603  *VOPER,coordz(1),coordz(1),MULT,1/Re
  2604  !   
  2605  ! Preenchendo o convergence e pressure com as coordenadas   
  2606  *VMASK,n_sel(1)				 
  2607  *VFUN,convergencex(1,2),COMP,coordz(1)  
  2608  *VMASK,n_sel(1)				 
  2609  *VFUN,convergencey(1,2),COMP,coordz(1)  
  2610  *VMASK,n_sel(1) 
  2611  *VFUN,stressx(1,2),COMP,coordz(1)   
  2612  *VMASK,n_sel(1) 
  2613  *VFUN,stressy(1,2),COMP,coordz(1)   
  2614  !   
  2615  ! preenchendo o convergence com a convergência 
  2616  *DO,i,1,nanalises,1 
  2617  	! identifica o passo   
  2618  	*IF,i,EQ,nanalises,THEN
  2619  		SUBSET,LAST   
  2620  	*ELSE  
  2621  		*IF,matmacico,LE,1,AND,matrev,EQ,0,THEN   
  2622  			SUBSET,LAST  
  2623  		*ELSE 
  2624  			SUBSET,i,,,,,,   
  2625  		*ENDIF
  2626  	*ENDIF 
  2627  	!  
  2628  	! Preenchendo o array com os deslocamentos radiais e tensões radiais  
  2629  	*VMASK,n_sel(1)
  2630  	*VGET,u_x(1),NODE,1,U,X
  2631  	*VOPER,u_x(1),u_x(1),MULT,-1/Re*100
  2632  	!  
  2633  	*VMASK,n_sel(1)
  2634  	*VGET,u_y(1),NODE,1,U,Y
  2635  	*VOPER,u_y(1),u_y(1),MULT,-1/Re*100
  2636  	!  
  2637  	*VMASK,n_sel(1)
  2638  	*VGET,s_x(1),NODE,1,S,X
  2639  	*VOPER,s_x(1),s_x(1),MULT,1
  2640  	!  
  2641  	*VMASK,n_sel(1)
  2642  	*VGET,s_y(1),NODE,1,S,Y
  2643  	*VOPER,s_y(1),s_y(1),MULT,1
  2644  	!  
  2645  	   
  2646  	! Preenchendo o convergence e pressure 
  2647  	*VMASK,n_sel(1)
  2648  	*VFUN,convergencex(1,2+i),COMP,u_x(1)  
  2649  	   
  2650  	*VMASK,n_sel(1)
  2651  	*VFUN,convergencey(1,2+i),COMP,u_y(1)  
  2652  	   
  2653  	*VMASK,n_sel(1)
  2654  	*VFUN,stressx(1,2+i),COMP,s_x(1)   
  2655  	   
  2656  	*VMASK,n_sel(1)
  2657  	*VFUN,stressy(1,2+i),COMP,s_y(1)   
  2658  	   
  2659  *ENDDO  
  2660  !   
  2661  ! ordena a tabela de acordo com a segunda coluna (das coordenadas)  
  2662  *MOPER,ORDER,convergencex,SORT,convergencex(1,2)
  2663  *MOPER,ORDER,convergencey,SORT,convergencey(1,2)
  2664      
  2665  *MOPER,ORDER,stressx,SORT,stressx(1,2)  
  2666  *MOPER,ORDER,stressy,SORT,stressy(1,2)  
  2667  !   
  2668  ! Coleta o maior valor das convergências   
  2669  *VSCFUN,uxmaximofinal,max,convergencex(1,2+nanalises)   
  2670  *VSCFUN,uymaximofinal,max,convergencey(1,2+nanalises)   
  2671  !   
  2672  *VSCFUN,sxmaximofinal,max,stressx(1,2+nanalises)
  2673  *VSCFUN,sxminimofinal,min,stressx(1,2+nanalises)
  2674  !   
  2675  *VSCFUN,symaximofinal,max,stressy(1,2+nanalises)
  2676  *VSCFUN,syminimofinal,min,stressy(1,2+nanalises)
  2677  !   
  2678  ! formatando grafico de convergencia x  
  2679  /RGB,INDEX,100,100,100,0
  2680  /RGB,INDEX,0,0,0,15 
  2681  /AXLAB,X,Z/Re   
  2682  /AXLAB,Y,Ux=-ux(r=Re,theta=%teta%)/Re (%)   
  2683  /XRANGE,0,Lt/Re 
  2684  /YRANGE,uxmaximofinal*1.2,0 
  2685  /GROPT,DIVY,20  
  2686  /GROPT,DIVX,10  
  2687  /GROPT,DIG1,3   
  2688  /GTHK,CURVE,1   
  2689  /PLOPTS,INFO,on 
  2690  !   
  2691  ! graficando na tela do Ansys   
  2692  /ERASE  
