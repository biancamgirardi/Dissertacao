  2158  	NROPT,FULL 
  2159  *ELSEIF,nr,eq,3,then		  
  2160  	NROPT,UNSYM
  2161  *ENDIF	 
  2162  *IF,psc,eq,0,then		 
  2163  	PSCONTROL,ALL,OFF  
  2164  *ELSEIF,nlg,eq,1,then		 
  2165  	PSCONTROL,ALL,ON   
