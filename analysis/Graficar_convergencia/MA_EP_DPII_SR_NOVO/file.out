  3103  /INPUT,ansuitmp 
  3104  !   
  3105  ! Cria arquivo com os parâmetros   
  3106  PARSAV,SCALAR,parametros,txt
  3107  !   
  3108  !   
  3109  !************************************************************!  
  3110  !****_ 		5.5 Tensões em uma dada cota (teta = 0)	_****!
  3111  !************************************************************!  
  3112  /POST1  
  3113  !   
  3114  teta		= 0			! ângulo   
  3115  zf		= l1+l2 		! cota ao longo dez   
  3116  !   
  3117  ! selecionando os nós na interface entre revestimento e o maciço  
  3118  *IF,teta,EQ,0,THEN  
  3119  	CSYS,0,
  3120  	ALLSEL,ALL 
  3121  	NSEL,S,LOC,X,-d4,d1/2  
  3122  	NSEL,R,LOC,Y,0,0   
  3123  	NSEL,R,LOC,Z,zf
  3124  	NSLE,R,CORNER  
  3125  	CSYS,0 
  3126  	eixo = 'x' 
  3127  	localizacao = 'x'  
  3128  *ELSE   
  3129  	CSYS,0,
  3130  	ALLSEL,ALL 
  3131  	NSEL,S,LOC,X,0,0   
  3132  	NSEL,R,LOC,Y,0,d3  
  3133  	NSEL,R,LOC,Z,zf
  3134  	NSLE,R,CORNER  
  3135  	CSYS,0 
  3136  	eixo = 'y' 
  3137  	localizacao = 'y'  
  3138  *ENDIF  
  3139  !   
  3140  ! sistemas de referencias dos resultados
  3141  RSYS,1  
  3142  !   
  3143  ! dimensionando arrays  
  3144  nanalises = 0   
  3145  *GET,nanalises,ACTIVE,0,SET,NSET	! pegando o número de análises								   
  3146  *GET,ncount,NODE,,COUNT			  ! pegando numero máximo de nós selecionados   
  3147  *GET,ntotal,NODE,,NUM,MAX		  ! pegando numero total de nós 
  3148      
  3149  *DIM,convergencex,TABLE,ncount,2+nanalises ! dimensionando tabela de convergencias  
  3150  *DIM,convergencey,TABLE,ncount,2+nanalises ! dimensionando tabela de convergencias  
  3151      
  3152  *DIM,stressx,TABLE,ncount,2+nanalises	  ! dimensionando tabela de pressões em x
  3153  *DIM,stressy,TABLE,ncount,2+nanalises	  ! dimensionando tabela de pressões em y
  3154      
  3155  *DIM,coordz,ARRAY,ntotal		  ! dimensionando vetor de coordenadas nodais 
  3156      
  3157  *DIM,ORDER,ARRAY,ncount			  ! array auxiliar para ordenamento   
  3158      
  3159      
  3160  *DIM,u_x,ARRAY,ntotal			  ! dimensionando vetor de deslocamentos em x   
  3161  *DIM,u_y,ARRAY,ntotal			  ! dimensionando vetor de deslocamentos em y   
  3162      
  3163  *DIM,s_x,ARRAY,ntotal			  ! dimensionando vetor de pressões em x   
  3164  *DIM,s_y,ARRAY,ntotal			  ! dimensionando vetor de pressões em y   
  3165      
  3166  *DIM,n_sel,ARRAY,ntotal			  ! dimensionando vetor que indica se o nó está selecionado 
  3167  !   
  3168  ! coloca lista de nós em ordem na primeira coluna  
  3169  *VGET,convergencex(1,1),NODE,,NLIST 
  3170  *VGET,convergencey(1,1),NODE,,NLIST 
  3171  *VGET,stressx(1,1),NODE,,NLIST  
  3172  *VGET,stressy(1,1),NODE,,NLIST  
  3173  !   
  3174  ! criando vetor de coordenadas  
  3175  *VGET,n_sel(1),NODE,1,NSEL  
  3176  *VGET,coordz(1),NODE,1,LOC,localizacao  
  3177  *VOPER,coordz(1),coordz(1),MULT,1 !1/Re 
  3178  !   
  3179  ! Preenchendo o convergence e pressure com as coordenadas   
  3180  *VMASK,n_sel(1)				 
  3181  *VFUN,convergencex(1,2),COMP,coordz(1)  
  3182  *VMASK,n_sel(1)				 
  3183  *VFUN,convergencey(1,2),COMP,coordz(1)  
  3184  *VMASK,n_sel(1) 
  3185  *VFUN,stressx(1,2),COMP,coordz(1)   
  3186  *VMASK,n_sel(1) 
  3187  *VFUN,stressy(1,2),COMP,coordz(1)   
  3188  !   
  3189  ! preenchendo o convergence com a convergência 
  3190  *DO,i,1,nanalises,1 
  3191  	! identifica o passo   
  3192  	*IF,i,EQ,nanalises,THEN
  3193  		SUBSET,LAST   
  3194  	*ELSE  
  3195  		*IF,matmacico,LE,1,AND,matrev,EQ,0,THEN   
  3196  			SUBSET,LAST  
  3197  		*ELSE 
  3198  			SUBSET,i,,,,,,   
  3199  		*ENDIF
  3200  	*ENDIF 
  3201  	!  
  3202  	! Preenchendo o array com os deslocamentos radiais e tensões radiais  
  3203  	*VMASK,n_sel(1)
  3204  	*VGET,u_x(1),NODE,1,U,X
  3205  	*VOPER,u_x(1),u_x(1),MULT,-1/Re*100
  3206  	!  
  3207  	*VMASK,n_sel(1)
  3208  	*VGET,u_y(1),NODE,1,U,Y
  3209  	*VOPER,u_y(1),u_y(1),MULT,-1/Re*100
  3210  	!  
  3211  	*VMASK,n_sel(1)
  3212  	*VGET,s_x(1),NODE,1,S,X
  3213  	*VOPER,s_x(1),s_x(1),MULT,1
  3214  	!  
  3215  	*VMASK,n_sel(1)
  3216  	*VGET,s_y(1),NODE,1,S,Y
  3217  	*VOPER,s_y(1),s_y(1),MULT,1
  3218  	!  
  3219  	   
  3220  	! Preenchendo o convergence e pressure 
  3221  	*VMASK,n_sel(1)
  3222  	*VFUN,convergencex(1,2+i),COMP,u_x(1)  
  3223  	   
  3224  	*VMASK,n_sel(1)
  3225  	*VFUN,convergencey(1,2+i),COMP,u_y(1)  
  3226  	   
  3227  	*VMASK,n_sel(1)
  3228  	*VFUN,stressx(1,2+i),COMP,s_x(1)   
  3229  	   
  3230  	*VMASK,n_sel(1)
  3231  	*VFUN,stressy(1,2+i),COMP,s_y(1)   
  3232  	   
  3233  *ENDDO  
  3234  !   
  3235  ! ordena a tabela de acordo com a segunda coluna (das coordenadas)  
  3236  *MOPER,ORDER,convergencex,SORT,convergencex(1,2)
  3237  *MOPER,ORDER,convergencey,SORT,convergencey(1,2)
  3238      
  3239  *MOPER,ORDER,stressx,SORT,stressx(1,2)  
  3240  *MOPER,ORDER,stressy,SORT,stressy(1,2)  
  3241  !   
  3242  ! Coleta o maior valor das convergências   
  3243  *VSCFUN,uxmaximofinal,max,convergencex(1,2+nanalises)   
  3244  *VSCFUN,uymaximofinal,max,convergencey(1,2+nanalises)   
  3245  !   
  3246  *VSCFUN,sxmaximofinal,max,stressx(1,2+nanalises)
  3247  *VSCFUN,sxminimofinal,min,stressx(1,2+nanalises)
  3248  !   
  3249  *VSCFUN,symaximofinal,max,stressy(1,2+nanalises)
  3250  *VSCFUN,syminimofinal,min,stressy(1,2+nanalises)
  3251  !   
  3252  ! formatando grafico de convergencia x  
  3253  /RGB,INDEX,100,100,100,0
  3254  /RGB,INDEX,0,0,0,15 
  3255  /AXLAB,X,%eixo% 
  3256  /AXLAB,Y,Ux=-ux(r,theta=%teta%)/Re (%)  
  3257  /XRANGE,DEFAULT 
  3258  /YRANGE,DEFAULT 
  3259  /GROPT,DIVY,20  
  3260  /GROPT,DIVX,10  
  3261  /GROPT,DIG1,3   
  3262  /GTHK,CURVE,1   
  3263  /PLOPTS,INFO,on 
  3264  !   
  3265  ! graficando na tela do Ansys   
  3266  /ERASE  
  3267  /SHOW,JPEG,,iso 
  3268  *DO,i,1,nanalises,1 
  3269  	*IF,i,EQ,nanalises,THEN
  3270  		/COLOR,CURVE,MAGE,1   
  3271  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  3272  		/COLOR,CURVE,YELL,1   
  3273  	*ELSE  
  3274  		/COLOR,CURVE,LGRA,1   
  3275  	*ENDIF 
  3276  	*VPLOT,convergencex(1,2),convergencex(1,2+i)   
  3277  	/NOERASE   
  3278  *ENDDO  
  3279  /SHOW,CLOSE 
  3280  /ERASE  
  3281  !   
  3282  ! formatando grafico de convergencia y  
  3283  /RGB,INDEX,100,100,100,0
  3284  /RGB,INDEX,0,0,0,15 
  3285  /AXLAB,X,%eixo% 
  3286  /AXLAB,Y,Uy=-uy(r,theta=%teta%)/Re (%)  
  3287  /XRANGE,DEFAULT 
  3288  /YRANGE,DEFAULT 
  3289  /GROPT,DIVY,20  
  3290  /GROPT,DIVX,10  
  3291  /GROPT,DIG1,3   
  3292  /GTHK,CURVE,1   
  3293  /PLOPTS,INFO,on 
  3294  !   
  3295  ! graficando na tela do Ansys   
  3296  /ERASE  
  3297  /SHOW,JPEG,,iso 
  3298  *DO,i,1,nanalises,1 
  3299  	*IF,i,EQ,nanalises,THEN
  3300  		/COLOR,CURVE,MAGE,1   
  3301  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  3302  		/COLOR,CURVE,YELL,1   
  3303  	*ELSE  
  3304  		/COLOR,CURVE,LGRA,1   
  3305  	*ENDIF 
  3306  	*VPLOT,convergencey(1,2),convergencey(1,2+i)   
  3307  	/NOERASE   
  3308  *ENDDO  
  3309  /SHOW,CLOSE 
  3310  /ERASE  
  3311  !   
  3312  !   
  3313  ! formatando grafico do stress x
  3314  /RGB,INDEX,100,100,100,0
  3315  /RGB,INDEX,0,0,0,15 
  3316  /AXLAB,X,%eixo% 
  3317  /AXLAB,Y,Sx(r,theta=%teta%)(MPa)
  3318  /XRANGE,DEFAULT 
  3319  /YRANGE,DEFAULT 
  3320  /GROPT,DIVY,20  
  3321  /GROPT,DIVX,10  
  3322  /GROPT,DIG1,3   
  3323  /GTHK,CURVE,1   
  3324  /PLOPTS,INFO,on 
  3325  !   
  3326  ! graficando na tela do Ansys   
  3327  /ERASE  
  3328  /SHOW,JPEG,,iso 
  3329  *DO,i,1,nanalises,1 
  3330  	*IF,i,EQ,nanalises,THEN
  3331  		/COLOR,CURVE,MAGE,1   
  3332  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  3333  		/COLOR,CURVE,YELL,1   
  3334  	*ELSE  
  3335  		/COLOR,CURVE,LGRA,1   
  3336  	*ENDIF 
  3337  	*VPLOT,stressx(1,2),stressx(1,2+i) 
  3338  	/NOERASE   
  3339  *ENDDO  
  3340  /SHOW,CLOSE 
  3341  /ERASE  
  3342  !   
  3343  ! formatando grafico do stress y
  3344  /RGB,INDEX,100,100,100,0
  3345  /RGB,INDEX,0,0,0,15 
  3346  /AXLAB,X,%eixo% 
  3347  /AXLAB,Y,Sy(r,theta=%teta%)(MPa)
  3348  /XRANGE,DEFAULT 
  3349  /YRANGE,DEFAULT 
  3350  /GROPT,DIVY,20  
  3351  /GROPT,DIVX,10  
  3352  /GROPT,DIG1,3   
  3353  /GTHK,CURVE,1   
  3354  /PLOPTS,INFO,on 
  3355  !   
  3356  ! graficando na tela do Ansys   
