  3615  		/COLOR,CURVE,MAGE,1   
  3616  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  3617  		/COLOR,CURVE,YELL,1   
  3618  	*ELSE  
  3619  		/COLOR,CURVE,LGRA,1   
  3620  	*ENDIF 
  3621  	*VPLOT,convergencey(1,2),convergencey(1,2+i)   
