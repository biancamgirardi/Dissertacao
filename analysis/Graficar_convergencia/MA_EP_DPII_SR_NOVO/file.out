  2712  /AXLAB,Y,Uy=-uy(r=Re,theta=%teta%)/Re (%)   
  2713  /XRANGE,0,Lt/Re 
  2714  /YRANGE,uymaximofinal*1.2,0 
  2715  /GROPT,DIVY,20  
  2716  /GROPT,DIVX,10  
  2717  /GROPT,DIG1,3   
  2718  /GTHK,CURVE,1   
