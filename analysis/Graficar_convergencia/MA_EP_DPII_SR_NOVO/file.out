  2825  !   
  2826  ! Cria arquivo com os parâmetros   
  2827  PARSAV,SCALAR,parametros,txt
  2828  !   
  2829  !   
  2830  !************************************************************!  
  2831  !****_ 		5.4 Perfis tunel longitudinal (teta=0)  _****! 
  2832  !************************************************************!  
  2833  /POST1  
  2834  !   
  2835  teta		= 0		! angulo da posição do perfil de convergências no túnel longitudinal 
  2836  !   
  2837  ! selecionando os nós na interface entre revestimento e o maciço  
  2838  LOCAL,11,1,0,0,lt,0,0,0,0   
  2839  CSYS,11,
  2840  ALLSEL,ALL  
  2841  NSEL,R,LOC,X,Re-0.01,Re+0.01
  2842  NSEL,R,LOC,Y,teta-0.01,teta+0.01
  2843  NSLE,R,CORNER   
  2844  CSYS,0  
  2845  !   
  2846  ! sistemas de referencias dos resultados
  2847  RSYS,1  
  2848  !   
  2849  ! dimensionando arrays  
  2850  nanalises = 0   
  2851  *GET,nanalises,ACTIVE,0,SET,NSET	! pegando o número de análises								   
  2852  *GET,ncount,NODE,,COUNT			  ! pegando numero máximo de nós selecionados   
  2853  *GET,ntotal,NODE,,NUM,MAX		  ! pegando numero total de nós 
  2854      
  2855  *DIM,convergencex,TABLE,ncount,2+nanalises ! dimensionando tabela de convergencias  
  2856  *DIM,convergencey,TABLE,ncount,2+nanalises ! dimensionando tabela de convergencias  
  2857      
  2858  *DIM,stressx,TABLE,ncount,2+nanalises	  ! dimensionando tabela de pressões em x
  2859  *DIM,stressy,TABLE,ncount,2+nanalises	  ! dimensionando tabela de pressões em y
  2860      
  2861  *DIM,coordz,ARRAY,ntotal		  ! dimensionando vetor de coordenadas nodais 
  2862      
  2863  *DIM,ORDER,ARRAY,ncount			  ! array auxiliar para ordenamento   
  2864      
  2865  *DIM,u_x,ARRAY,ntotal			  ! dimensionando vetor de deslocamentos em x   
  2866  *DIM,u_y,ARRAY,ntotal			  ! dimensionando vetor de deslocamentos em y   
  2867      
  2868  *DIM,s_x,ARRAY,ntotal			  ! dimensionando vetor de pressões em x   
  2869  *DIM,s_y,ARRAY,ntotal			  ! dimensionando vetor de pressões em y   
  2870      
  2871  *DIM,n_sel,ARRAY,ntotal			  ! dimensionando vetor que indica se o nó está selecionado 
  2872  !   
  2873  ! coloca lista de nós em ordem na primeira coluna  
  2874  *VGET,convergencex(1,1),NODE,,NLIST 
  2875  *VGET,convergencey(1,1),NODE,,NLIST 
  2876  *VGET,stressx(1,1),NODE,,NLIST  
  2877  *VGET,stressy(1,1),NODE,,NLIST  
  2878  !   
  2879  ! criando vetor de coordenadas  
  2880  *VGET,n_sel(1),NODE,1,NSEL  
  2881  *VGET,coordz(1),NODE,1,LOC,z
  2882  *VOPER,coordz(1),coordz(1),MULT,1/Re
  2883  !   
  2884  ! Preenchendo o convergence e pressure com as coordenadas   
  2885  *VMASK,n_sel(1)				 
  2886  *VFUN,convergencex(1,2),COMP,coordz(1)  
  2887  *VMASK,n_sel(1)				 
  2888  *VFUN,convergencey(1,2),COMP,coordz(1)  
  2889  *VMASK,n_sel(1) 
  2890  *VFUN,stressx(1,2),COMP,coordz(1)   
  2891  *VMASK,n_sel(1) 
  2892  *VFUN,stressy(1,2),COMP,coordz(1)   
  2893  !   
  2894  ! preenchendo o convergence com a convergência 
  2895  *DO,i,1,nanalises,1 
  2896  	! identifica o passo   
  2897  	*IF,i,EQ,nanalises,THEN
  2898  		SUBSET,LAST   
  2899  	*ELSE  
  2900  		*IF,matmacico,LE,1,AND,matrev,EQ,0,THEN   
  2901  			SUBSET,LAST  
  2902  		*ELSE 
  2903  			SUBSET,i,,,,,,   
  2904  		*ENDIF
  2905  	*ENDIF 
  2906  	!  
  2907  	! Preenchendo o array com os deslocamentos radiais e tensões radiais  
  2908  	*VMASK,n_sel(1)
  2909  	*VGET,u_x(1),NODE,1,U,X
  2910  	*VOPER,u_x(1),u_x(1),MULT,-1/Re*100
  2911  	!  
  2912  	*VMASK,n_sel(1)
  2913  	*VGET,u_y(1),NODE,1,U,Y
  2914  	*VOPER,u_y(1),u_y(1),MULT,-1/Re*100
  2915  	!  
  2916  	*VMASK,n_sel(1)
  2917  	*VGET,s_x(1),NODE,1,S,X
  2918  	*VOPER,s_x(1),s_x(1),MULT,1
  2919  	!  
  2920  	*VMASK,n_sel(1)
  2921  	*VGET,s_y(1),NODE,1,S,Y
  2922  	*VOPER,s_y(1),s_y(1),MULT,1
  2923  	!  
  2924  	   
  2925  	! Preenchendo o convergence e pressure 
  2926  	*VMASK,n_sel(1)
  2927  	*VFUN,convergencex(1,2+i),COMP,u_x(1)  
  2928  	   
  2929  	*VMASK,n_sel(1)
  2930  	*VFUN,convergencey(1,2+i),COMP,u_y(1)  
  2931  	   
  2932  	*VMASK,n_sel(1)
  2933  	*VFUN,stressx(1,2+i),COMP,s_x(1)   
  2934  	   
  2935  	*VMASK,n_sel(1)
  2936  	*VFUN,stressy(1,2+i),COMP,s_y(1)   
  2937  	   
  2938  *ENDDO  
  2939  !   
  2940  ! ordena a tabela de acordo com a segunda coluna (das coordenadas)  
  2941  *MOPER,ORDER,convergencex,SORT,convergencex(1,2)
  2942  *MOPER,ORDER,convergencey,SORT,convergencey(1,2)
  2943      
  2944  *MOPER,ORDER,stressx,SORT,stressx(1,2)  
  2945  *MOPER,ORDER,stressy,SORT,stressy(1,2)  
  2946  !   
  2947  ! Coleta o maior valor das convergências   
  2948  *VSCFUN,uxmaximofinal,max,convergencex(1,2+nanalises)   
  2949  *VSCFUN,uymaximofinal,max,convergencey(1,2+nanalises)   
  2950  !   
  2951  *VSCFUN,sxmaximofinal,max,stressx(1,2+nanalises)
  2952  *VSCFUN,sxminimofinal,min,stressx(1,2+nanalises)
  2953  !   
  2954  *VSCFUN,symaximofinal,max,stressy(1,2+nanalises)
  2955  *VSCFUN,syminimofinal,min,stressy(1,2+nanalises)
  2956  !   
  2957  ! formatando grafico de convergencia x  
  2958  /RGB,INDEX,100,100,100,0
  2959  /RGB,INDEX,0,0,0,15 
  2960  /AXLAB,X,Z/Re   
  2961  /AXLAB,Y,Ux=-ux(r=Re,theta=%teta%)/Re (%)   
  2962  /XRANGE,0,Lt/Re 
  2963  /YRANGE,uxmaximofinal*1.2,0 
  2964  /GROPT,DIVY,20  
  2965  /GROPT,DIVX,10  
  2966  /GROPT,DIG1,3   
  2967  /GTHK,CURVE,1   
  2968  /PLOPTS,INFO,on 
  2969  !   
  2970  ! graficando na tela do Ansys   
  2971  /ERASE  
  2972  /SHOW,JPEG,,iso 
  2973  *DO,i,1,nanalises,1 
  2974  	*IF,i,EQ,nanalises,THEN
  2975  		/COLOR,CURVE,MAGE,1   
  2976  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  2977  		/COLOR,CURVE,YELL,1   
  2978  	*ELSE  
  2979  		/COLOR,CURVE,LGRA,1   
  2980  	*ENDIF 
  2981  	*VPLOT,convergencex(1,2),convergencex(1,2+i)   
  2982  	/NOERASE   
  2983  *ENDDO  
  2984  /SHOW,CLOSE 
  2985  /ERASE  
  2986  !   
  2987  ! formatando grafico de convergencia y  
  2988  /RGB,INDEX,100,100,100,0
  2989  /RGB,INDEX,0,0,0,15 
  2990  /AXLAB,X,Z/Re   
  2991  /AXLAB,Y,Uy=-uy(r=Re,theta=%teta%)/Re (%)   
  2992  /XRANGE,0,Lt/Re 
  2993  /YRANGE,uymaximofinal*1.2,0 
  2994  /GROPT,DIVY,20  
  2995  /GROPT,DIVX,10  
  2996  /GROPT,DIG1,3   
  2997  /GTHK,CURVE,1   
  2998  /PLOPTS,INFO,on 
  2999  !   
  3000  ! graficando na tela do Ansys   
  3001  /ERASE  
  3002  /SHOW,JPEG,,iso 
  3003  *DO,i,1,nanalises,1 
  3004  	*IF,i,EQ,nanalises,THEN
  3005  		/COLOR,CURVE,MAGE,1   
  3006  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  3007  		/COLOR,CURVE,YELL,1   
  3008  	*ELSE  
  3009  		/COLOR,CURVE,LGRA,1   
  3010  	*ENDIF 
  3011  	*VPLOT,convergencey(1,2),convergencey(1,2+i)   
  3012  	/NOERASE   
  3013  *ENDDO  
  3014  /SHOW,CLOSE 
  3015  /ERASE  
  3016  !   
  3017  !   
  3018  ! formatando grafico do stress x
  3019  /RGB,INDEX,100,100,100,0
  3020  /RGB,INDEX,0,0,0,15 
  3021  /AXLAB,X,Z/Re   
  3022  /AXLAB,Y,Sx(r=Re,theta=%teta%)(MPa) 
  3023  /XRANGE,0,Lt/Re 
  3024  /YRANGE,sxmaximofinal*1.2,sxminimofinal*1.2 
  3025  /GROPT,DIVY,20  
  3026  /GROPT,DIVX,10  
  3027  /GROPT,DIG1,3   
  3028  /GTHK,CURVE,1   
  3029  /PLOPTS,INFO,on 
  3030  !   
  3031  ! graficando na tela do Ansys   
  3032  /ERASE  
  3033  /SHOW,JPEG,,iso 
  3034  *DO,i,1,nanalises,1 
