  3640  !   
  3641  ! graficando na tela do Ansys   
  3642  /ERASE  
  3643  /SHOW,JPEG,,iso 
  3644  *DO,i,1,nanalises,1 
  3645  	*IF,i,EQ,nanalises,THEN
  3646  		/COLOR,CURVE,MAGE,1   
  3647  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  3648  		/COLOR,CURVE,YELL,1   
  3649  	*ELSE  
  3650  		/COLOR,CURVE,LGRA,1   
  3651  	*ENDIF 
  3652  	*VPLOT,stressx(1,2),stressx(1,2+i) 
  3653  	/NOERASE   
