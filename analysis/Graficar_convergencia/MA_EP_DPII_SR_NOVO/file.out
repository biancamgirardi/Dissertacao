  3050  /RGB,INDEX,0,0,0,15 
  3051  /AXLAB,X,Z/Re   
  3052  /AXLAB,Y,Sy(r=Re,theta=%teta%)(MPa) 
  3053  /XRANGE,0,Lt/Re 
  3054  /YRANGE,symaximofinal,syminimofinal 
  3055  /GROPT,DIVY,20  
  3056  /GROPT,DIVX,10  
  3057  /GROPT,DIG1,3   
  3058  /GTHK,CURVE,1   
