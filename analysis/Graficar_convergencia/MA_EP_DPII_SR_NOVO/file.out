  1901  !****_ 		3.12 Condições de contorno		_****!   
  1902  !************************************************************!  
  1903  CSYS,0  
  1904  ! aplica tensões iniciais  
  1905  ALLSEL,ALL  
  1906  INISTATE, DEFINE,,,,,-prx,-pry,-prz,0,0,0   
  1907  !   
  1908  !Aplica condição de simetria na face direita do modelo
