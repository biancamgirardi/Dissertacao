  3036  		/COLOR,CURVE,MAGE,1   
  3037  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  3038  		/COLOR,CURVE,YELL,1   
  3039  	*ELSE  
  3040  		/COLOR,CURVE,LGRA,1   
  3041  	*ENDIF 
  3042  	*VPLOT,stressx(1,2),stressx(1,2+i) 
  3043  	/NOERASE   
