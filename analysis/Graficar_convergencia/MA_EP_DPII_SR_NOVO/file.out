  3623  *ENDDO  
  3624  /SHOW,CLOSE 
  3625  /ERASE  
  3626  !   
  3627  !   
  3628  ! formatando grafico do stress x
  3629  /RGB,INDEX,100,100,100,0
  3630  /RGB,INDEX,0,0,0,15 
  3631  /AXLAB,X,%eixo% 
  3632  /AXLAB,Y,Sx(r,theta=%teta%)(MPa)
  3633  /XRANGE,DEFAULT 
  3634  /YRANGE,DEFAULT 
  3635  /GROPT,DIVY,20  
  3636  /GROPT,DIVX,10  
  3637  /GROPT,DIG1,3   
  3638  /GTHK,CURVE,1   
