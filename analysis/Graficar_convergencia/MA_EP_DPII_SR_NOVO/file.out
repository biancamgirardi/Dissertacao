  3390  (1000(E10.4,3X))
  3391  *END
  3392  /INPUT,ansuitmp 
  3393  !   
  3394  *CREATE,ansuitmp
  3395  *MWRITE,stressy,stressy_zf_%teta%,txt   
  3396  (1000(E10.4,3X))
  3397  *END
  3398  /INPUT,ansuitmp 
  3399  !   
  3400  ! Cria arquivo com os parâmetros   
  3401  PARSAV,SCALAR,parametros,txt
  3402  !   
  3403  !************************************************************!  
  3404  !****_ 		5.5 Tensões uma dada cota (teta = 90)   _****!
  3405  !************************************************************!  
  3406  /POST1  
  3407  !   
  3408  teta		= 135			! ângulo 
  3409  zf		= l1+l2 		! cota ao longo dez   
  3410  !   
  3411  ! selecionando os nós na interface entre revestimento e o maciço  
  3412  *IF,teta,EQ,0,THEN  
  3413  	CSYS,0,
  3414  	ALLSEL,ALL 
  3415  	NSEL,S,LOC,X,-d4,d1/2  
  3416  	NSEL,R,LOC,Y,0,0   
  3417  	NSEL,R,LOC,Z,zf
  3418  	NSLE,R,CORNER  
  3419  	CSYS,0 
  3420  	eixo = 'x' 
  3421  	localizacao = 'x'  
  3422  *ELSEIF,teta,EQ,90,THEN 
  3423  	CSYS,0,
  3424  	ALLSEL,ALL 
  3425  	ESEL,S,LIVE
  3426  	NSEL,S,LOC,X,0,0   
  3427  	NSEL,R,LOC,Y,0,d3  
  3428  	NSEL,R,LOC,Z,zf
  3429  	NSLE,R,CORNER  
  3430  	CSYS,0 
  3431  	eixo = 'y' 
  3432  	localizacao = 'y'  
  3433  *ELSEIF,teta,EQ,45,THEN 
  3434  	CSYS,1,
  3435  	ALLSEL,ALL 
  3436  	NSEL,S,LOC,X,0,10  
  3437  	NSEL,R,LOC,Y,45,45 
  3438  	NSEL,R,LOC,Z,zf
  3439  	NSLE,R,CORNER  
  3440  	CSYS,1 
  3441  	eixo = 'r' 
  3442  	localizacao = 'X'  
  3443  *ELSEIF,teta,EQ,135,THEN
  3444  	CSYS,1,
  3445  	ALLSEL,ALL 
  3446  	NSEL,S,LOC,X,0,d3  
  3447  	NSEL,R,LOC,Y,135,135   
  3448  	NSEL,R,LOC,Z,zf
  3449  	NSLE,R,CORNER  
  3450  	CSYS,1 
  3451  	eixo = 'r' 
  3452  	localizacao = 'X'	 
  3453  *ENDIF  
  3454  !   
  3455  ! sistemas de referencias dos resultados
  3456  RSYS,1  
  3457  !   
  3458  ! dimensionando arrays  
  3459  nanalises = 0   
  3460  *GET,nanalises,ACTIVE,0,SET,NSET	! pegando o número de análises								   
  3461  *GET,ncount,NODE,,COUNT			  ! pegando numero máximo de nós selecionados   
  3462  *GET,ntotal,NODE,,NUM,MAX		  ! pegando numero total de nós 
  3463      
  3464  *DIM,convergencex,TABLE,ncount,2+nanalises ! dimensionando tabela de convergencias  
  3465  *DIM,convergencey,TABLE,ncount,2+nanalises ! dimensionando tabela de convergencias  
  3466      
  3467  *DIM,stressx,TABLE,ncount,2+nanalises	  ! dimensionando tabela de pressões em x
  3468  *DIM,stressy,TABLE,ncount,2+nanalises	  ! dimensionando tabela de pressões em y
  3469      
  3470  *DIM,coordz,ARRAY,ntotal		  ! dimensionando vetor de coordenadas nodais 
  3471      
  3472  *DIM,ORDER,ARRAY,ncount			  ! array auxiliar para ordenamento   
  3473      
  3474      
  3475  *DIM,u_x,ARRAY,ntotal			  ! dimensionando vetor de deslocamentos em x   
  3476  *DIM,u_y,ARRAY,ntotal			  ! dimensionando vetor de deslocamentos em y   
  3477      
  3478  *DIM,s_x,ARRAY,ntotal			  ! dimensionando vetor de pressões em x   
  3479  *DIM,s_y,ARRAY,ntotal			  ! dimensionando vetor de pressões em y   
  3480      
  3481  *DIM,n_sel,ARRAY,ntotal			  ! dimensionando vetor que indica se o nó está selecionado 
  3482  !   
  3483  ! coloca lista de nós em ordem na primeira coluna  
  3484  *VGET,convergencex(1,1),NODE,,NLIST 
  3485  *VGET,convergencey(1,1),NODE,,NLIST 
  3486  *VGET,stressx(1,1),NODE,,NLIST  
  3487  *VGET,stressy(1,1),NODE,,NLIST  
  3488  !   
  3489  ! criando vetor de coordenadas  
  3490  *VGET,n_sel(1),NODE,1,NSEL  
  3491  *VGET,coordz(1),NODE,1,LOC,localizacao  
  3492  *VOPER,coordz(1),coordz(1),MULT,1 !1/Re 
  3493  !   
  3494  ! Preenchendo o convergence e pressure com as coordenadas   
  3495  *VMASK,n_sel(1)				 
  3496  *VFUN,convergencex(1,2),COMP,coordz(1)  
  3497  *VMASK,n_sel(1)				 
  3498  *VFUN,convergencey(1,2),COMP,coordz(1)  
  3499  *VMASK,n_sel(1) 
  3500  *VFUN,stressx(1,2),COMP,coordz(1)   
  3501  *VMASK,n_sel(1) 
  3502  *VFUN,stressy(1,2),COMP,coordz(1)   
  3503  !   
  3504  ! preenchendo o convergence com a convergência 
  3505  *DO,i,1,nanalises,1 
  3506  	! identifica o passo   
  3507  	*IF,i,EQ,nanalises,THEN
  3508  		SUBSET,LAST   
  3509  	*ELSE  
  3510  		*IF,matmacico,LE,1,AND,matrev,EQ,0,THEN   
  3511  			SUBSET,LAST  
  3512  		*ELSE 
  3513  			SUBSET,i,,,,,,   
  3514  		*ENDIF
  3515  	*ENDIF 
  3516  	!  
  3517  	! Preenchendo o array com os deslocamentos radiais e tensões radiais  
  3518  	*VMASK,n_sel(1)
  3519  	*VGET,u_x(1),NODE,1,U,X
  3520  	*VOPER,u_x(1),u_x(1),MULT,-1/Re*100
  3521  	!  
  3522  	*VMASK,n_sel(1)
  3523  	*VGET,u_y(1),NODE,1,U,Y
  3524  	*VOPER,u_y(1),u_y(1),MULT,-1/Re*100
  3525  	!  
  3526  	*VMASK,n_sel(1)
  3527  	*VGET,s_x(1),NODE,1,S,X
  3528  	*VOPER,s_x(1),s_x(1),MULT,1
  3529  	!  
  3530  	*VMASK,n_sel(1)
  3531  	*VGET,s_y(1),NODE,1,S,Y
  3532  	*VOPER,s_y(1),s_y(1),MULT,1
  3533  	!  
  3534  	   
  3535  	! Preenchendo o convergence e pressure 
  3536  	*VMASK,n_sel(1)
  3537  	*VFUN,convergencex(1,2+i),COMP,u_x(1)  
  3538  	   
  3539  	*VMASK,n_sel(1)
  3540  	*VFUN,convergencey(1,2+i),COMP,u_y(1)  
  3541  	   
  3542  	*VMASK,n_sel(1)
  3543  	*VFUN,stressx(1,2+i),COMP,s_x(1)   
  3544  	   
  3545  	*VMASK,n_sel(1)
  3546  	*VFUN,stressy(1,2+i),COMP,s_y(1)   
  3547  	   
  3548  *ENDDO  
  3549  !   
  3550  ! ordena a tabela de acordo com a segunda coluna (das coordenadas)  
  3551  *MOPER,ORDER,convergencex,SORT,convergencex(1,2)
  3552  *MOPER,ORDER,convergencey,SORT,convergencey(1,2)
  3553      
  3554  *MOPER,ORDER,stressx,SORT,stressx(1,2)  
  3555  *MOPER,ORDER,stressy,SORT,stressy(1,2)  
  3556  !   
  3557  ! Coleta o maior valor das convergências   
  3558  *VSCFUN,uxmaximofinal,max,convergencex(1,2+nanalises)   
  3559  *VSCFUN,uymaximofinal,max,convergencey(1,2+nanalises)   
  3560  !   
  3561  *VSCFUN,sxmaximofinal,max,stressx(1,2+nanalises)
  3562  *VSCFUN,sxminimofinal,min,stressx(1,2+nanalises)
  3563  !   
  3564  *VSCFUN,symaximofinal,max,stressy(1,2+nanalises)
  3565  *VSCFUN,syminimofinal,min,stressy(1,2+nanalises)
  3566  !   
  3567  ! formatando grafico de convergencia x  
  3568  /RGB,INDEX,100,100,100,0
  3569  /RGB,INDEX,0,0,0,15 
  3570  /AXLAB,X,%eixo% 
  3571  /AXLAB,Y,Ux=-ux(r,theta=%teta%)/Re (%)  
  3572  /XRANGE,DEFAULT 
  3573  /YRANGE,DEFAULT 
  3574  /GROPT,DIVY,20  
  3575  /GROPT,DIVX,10  
  3576  /GROPT,DIG1,3   
  3577  /GTHK,CURVE,1   
  3578  /PLOPTS,INFO,on 
  3579  !   
  3580  ! graficando na tela do Ansys   
  3581  /ERASE  
  3582  /SHOW,JPEG,,iso 
  3583  *DO,i,1,nanalises,1 
  3584  	*IF,i,EQ,nanalises,THEN
  3585  		/COLOR,CURVE,MAGE,1   
  3586  	*ELSEIF,i,EQ,nesc+nesc1-1,THEN 
  3587  		/COLOR,CURVE,YELL,1   
  3588  	*ELSE  
  3589  		/COLOR,CURVE,LGRA,1   
  3590  	*ENDIF 
  3591  	*VPLOT,convergencex(1,2),convergencex(1,2+i)   
  3592  	/NOERASE   
  3593  *ENDDO  
  3594  /SHOW,CLOSE 
  3595  /ERASE  
  3596  !   
  3597  ! formatando grafico de convergencia y  
  3598  /RGB,INDEX,100,100,100,0
  3599  /RGB,INDEX,0,0,0,15 
  3600  /AXLAB,X,%eixo% 
  3601  /AXLAB,Y,Uy=-uy(r,theta=%teta%)/Re (%)  
  3602  /XRANGE,DEFAULT 
  3603  /YRANGE,DEFAULT 
  3604  /GROPT,DIVY,20  
  3605  /GROPT,DIVX,10  
  3606  /GROPT,DIG1,3   
  3607  /GTHK,CURVE,1   
