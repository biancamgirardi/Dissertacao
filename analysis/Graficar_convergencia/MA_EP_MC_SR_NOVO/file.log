*VMASK,n_sel(1) 
*VFUN,convergencey(1,2+i),COMP,u_y(1)   
*VMASK,n_sel(1) 
*VFUN,stressx(1,2+i),COMP,s_x(1)
*VMASK,n_sel(1) 
*VFUN,stressy(1,2+i),COMP,s_y(1)
*ENDDO  
!   
! ordena a tabela de acordo com a segunda coluna (das coordenadas)  
