     1  ! ARQUIVO DE PÓS-PROCESSAMENTO - MODELOS 3D !  
     2  ! VERSÃO 01: 23/09/2024	       		    ! 
     3  ! SITUAÇÃO: OK		       		    !	   
     4      
     5  ! Acessando o arquivo de dados  
     6  RESUME,file,db  
     7      
     8  /POST1  
     9      
    10  ! Parâmetros   
    11  theta = 90		! Coordenada polar do perfil de convergências  
    12  npoints = 200		! Número de pontos de discretização do caminho
    13      
    14  ! Definindo o sistema de coordenadas cilindrico 
    15  CSYS,1  
    16      
    17  ! Selecionando o primeiro e último nó do caminho  
    18  ALLSEL,ALL  
    19  no1 = node(Re,theta,0)  
    20  no2 = node(Re,theta,lt) 
    21      
    22  ! Criando o caminho:
    23  ALLSEL,ALL  
    24  PATH,path1,2,20,npoints 
    25  PPATH,1,no1 
    26  PPATH,2,no2 
    27      
    28  ! Definindo o sistema de coordenadas (cilíndrico) para os resultados   
    29  RSYS,1		! Sistema cilíndrico - eixo z  
    30      
    31  ! Número de análises  
    32  *GET,nanalises,ACTIVE,0,SET,NSET
    33      
    34  ! Dimensionando a tabela de resultados  
    35  *DIM,tabela,TABLE,npoints,nanalises+1   
    36  *DIM,tabelasr,TABLE,npoints,nanalises+1 
    37      
    38  ! Preenchendo as tabelas de resultados  
    39  subpasso = 1
    40  *DO,subpasso,1,nanalises,1  
    41      
    42  	! Definindo o conjunto de dados o último loadstep 
    43  	SUBSET,subpasso
    44  	   
    45  	! Escrevendo a convergência   
    46  	PDEF,ur,U,X,AVG
    47  	PCALC,ADD,Ur_theta,ur,,-1/Re*100,, ,   
    48  	*DO,i,1,npoints,1  
    49  		*GET,tabela(i,1),PATH,0,ITEM,Zg,PATHPT,i  
    50  		*GET,tabela(i,subpasso+1),PATH,0,ITEM,Ur_theta,PATHPT,i   
    51  	*ENDDO 
    52  	   
    53  	! Escrevendo as tensões radiais   
    54  	PDEF,sr_theta,S,X,AVG  
    55  	*DO,i,1,npoints,1  
    56  		*GET,tabelasr(i,1),PATH,0,ITEM,Zg,PATHPT,i
    57  		*GET,tabelasr(i,subpasso+1),PATH,0,ITEM,sr_theta,PATHPT,i 
    58  	*ENDDO 
    59  	   
    60  *ENDDO  
    61      
    62  ! Escrevendo no arquivo 
    63  *CREATE,ansuitmp
    64  *MWRITE,tabela,tabela_%theta%,txt   
    65  (1000(E10.4,3X))
    66  *END
    67  /INPUT,ansuitmp 
    68      
    69  ! Escrevendo no arquivo 
    70  *CREATE,ansuitmp
    71  *MWRITE,tabelasr,tabelasr_%theta%,txt   
    72  (1000(E10.4,3X))
    73  *END
    74  /INPUT,ansuitmp 
    75      
    76  ! Cria arquivo com os parâmetros   
    77  PARSAV,ALL,parametros_postproc,txt  
    78      
    79  ! Lixo  
    80  ! Plotando o caminho
    81  !PLPATH,Ur_theta
    82      
    83  ! Printando o caminho   
    84  !PRPATH,Ur_theta

